{
	"incremental": true,
	"lineWidth": 140,
	"indentWidth": 4,
	"useTabs": true,
	"typescript": {
		"quoteStyle": "preferDouble",
		"semiColons": "always",
		"trailingCommas": "onlyMultiLine"
	},
	"json": {
		"indentWidth": 4,
		"useTabs": true
	},
	"markdown": {
		"lineWidth": 140
	},
	"markup_fmt": {
		"printWidth": 140,
		"useTabs": true,
		"indentWidth": 1,
		"whitespaceSensitivity": "css",
		"preferAttrsSingleLine": true,
		"closingBracketSameLine": true
	},
	"excludes": [
		"vendor/**",
		"docs/**",
		"static/**"
	],
	"plugins": [
		"https://plugins.dprint.dev/typescript-0.90.3.wasm",
		"https://plugins.dprint.dev/json-0.19.0.wasm",
		"https://plugins.dprint.dev/markdown-0.17.8.wasm",
		"https://plugins.dprint.dev/g-plane/malva-v0.16.0.wasm",
		"https://plugins.dprint.dev/g-plane/markup_fmt-v0.15.0.wasm"
	]
}
