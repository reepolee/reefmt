{#layout("layout") }

{#with props}
	<div class="p-4">

		<div class="flex items-center justify-between">
			<h1 class="mb-4">{= ui.title}</h1>
			<div class="text-sm">{~ js_timestamp_to_locale_string(record.updated_at ?? record.created_at)}</div>
		</div>

		{#if form_errors}
			<div class="py-4">
				<app-banner type="red">{= form_errors}</app-banner>
			</div>
		{/if}

		<form method="POST" action="{~ localized_path(action) }" class="grid gap-4 max-w-[60ch]" id="entry-form">

			<!-- CSRF token -->
			<input type="hidden" name="_csrf_token" value="{= csrf_token }" />

			<!-- crud:fields:start -->
			<field-wrapper class="grid" data-field="name">
				<label class="px-3" for="name">{= labels.name}</label>
				<input type="text" id="name" name="name" value="{= record.name}" />
				<validation-error class="mt-1" id="error-name"></validation-error>
			</field-wrapper>


			<field-wrapper class="grid" data-field="tagline">
				<label class="px-3" for="tagline">{= labels.tagline}</label>
				<input type="text" id="tagline" name="tagline" value="{= record.tagline}" />
				<validation-error class="mt-1" id="error-tagline"></validation-error>
			</field-wrapper>


			<field-wrapper class="grid" data-field="author_id">
				<label class="px-3" for="author_id">{= labels.author_id}</label>
				<select id="author_id" name="author_id" value="{= record.author_id}">
					<option value="">{= selectors.select}</option>
					{#each authors_options_by_id || [] as option}
						<option value="{= option.option_value }" {#if option.option_value == record.author_id } selected{/if}>{= option.option_text}</option>
					{/each}
				</select>
				<validation-error class="mt-1" id="error-author_id"></validation-error>
			</field-wrapper>


			<field-wrapper class="grid" data-field="reviewer_id">
				<label class="px-3" for="reviewer_id">{= labels.reviewer_id}</label>
				<select id="reviewer_id" name="reviewer_id" value="{= record.reviewer_id}">
					<option value="">{= selectors.select}</option>
					{#each authors_options_by_id || [] as option}
						<option value="{= option.option_value }" {#if option.option_value == record.reviewer_id } selected{/if}>{= option.option_text}</option>
					{/each}
				</select>
				<validation-error class="mt-1" id="error-reviewer_id"></validation-error>
			</field-wrapper>


			<field-wrapper class="grid" data-field="language_id">
				<label class="px-3" for="language_id">{= labels.language_id}</label>
				<select id="language_id" name="language_id" value="{= record.language_id}">
					<option value="">{= selectors.select}</option>
					{#each languages_options_by_id || [] as option}
						<option value="{= option.option_value }" {#if option.option_value == record.language_id } selected{/if}>{= option.option_text}</option>
					{/each}
				</select>
				<validation-error class="mt-1" id="error-language_id"></validation-error>
			</field-wrapper>


			<field-wrapper class="grid" data-field="first_commit_at">
				<label class="px-3" for="first_commit_at">{= labels.first_commit_at}</label>
				<input type="date" id="first_commit_at" name="first_commit_at" value="{~ js_date_to_iso_string(record.first_commit_at)}" />
				<validation-error class="mt-1" id="error-first_commit_at"></validation-error>
			</field-wrapper>


			<field-wrapper class="grid" data-field="is_javascript">
				<label class="px-3" for="is_javascript">{= labels.is_javascript}</label>
				<select id="is_javascript" name="is_javascript" value="{= record.is_javascript}">
					<option value="-1">{= selectors.select}</option>
					<option value="0" {#if 0 === record.is_javascript } selected{/if}>{= selectors["0"]}</option>
					<option value="1" {#if 1 === record.is_javascript } selected{/if}>{= selectors["1"]}</option>
				</select>
				<validation-error class="mt-1" id="error-is_javascript"></validation-error>
			</field-wrapper>

			<!-- crud:fields:end -->

			<!-- Store referrer URL as hidden field -->
			<input type="hidden" id="return_url" name="_return_url" value="" />

			<!-- Save action: hidden field set by onclick on save buttons -->
			<input type="hidden" name="_save_action" id="save_action" value="" />

			<div class="flex gap-2 mt-8 items-center">
				<button id="btn-submit" type="submit" onclick="document.getElementById('save_action').value='stay'">{= actions.save}</button>
				<button id="btn-save-close" type="submit" onclick="document.getElementById('save_action').value='close'" class="button secondary">{= actions.save_close}</button>
				<button id="btn-cancel" type="button" onclick="history.back()" class="button secondary">{= actions.cancel}</button>

				{#if (record.id) && enable_delete}
					<button id="action_delete" type="button" command="show-modal" commandfor="action_delete_dialog" class="ml-auto button tertiary">{= actions.delete}</button>
				{/if}
			</div>
		</form>

		{#if (record.id) && enable_delete}
			<form id="delete-form" method="POST" action="{~ localized_path('/user/frameworks/' + record.id + '/edit') }" style="display: none;">
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<input type="hidden" name="_action" value="delete" />
			</form>
		{/if}

	</div>

	{#if enable_delete}
		<dialog id="action_delete_dialog" class="p-0 rounded-xl shadow-2xl w-100">
			<div class="p-6">
				<h2 class="text-lg font-semibold">{= actions.delete}</h2>
				<div class="mt-6 flex justify-end gap-2">
					<button class="px-3 py-1 rounded bg-slate-200" type="button" commandfor="action_delete_dialog" command="close">{= actions.abort_delete}</button>
					<button class="px-3 py-1 rounded bg-brand text-white" type="button" data-dialog-confirm>{= actions.confirm_delete}</button>
				</div>
			</div>
		</dialog>
	{/if}
	<script src="/dialog-confirm.js?v={= version}"></script>
	<script src="/form-controller.js?v={= version}" defer></script>

	<script>
		const return_url_field = $("#return_url");
		if (return_url_field && document.referrer) {
			try {
				const referer_url = new URL(document.referrer);
				return_url_field.value = referer_url.pathname + referer_url.search;
			} catch (e) {}
		}
		{#if enable_delete};
		$("#action_delete_dialog").addEventListener("confirm", () => {
			$("#delete-form").submit();
		});
		{/if};
		document.addEventListener("DOMContentLoaded", () => {
			new FormController({ form: "#entry-form", validate_url: "{~ localized_path('/user/frameworks/validate') }", submitted_text: "{~ actions.submitted }" });
		});
	</script>
{/with}
