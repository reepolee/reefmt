{{
const c = {
	en: {
		title: "Contact | Reepolee",
		kicker: "Say hello",
		h1: "Well, **Hello!**",
		h3: "You might have expected a form here. Turns out **I hate those**. You never truly know where your data will end after that POST request and someone will start spammin' you the next day.",
		p1: "So, we are all **professionals** here. Open up your preferred **email** client and send me a request or pick up a **phone** and just text or call me. International charges might occur, so email is probably your best bet.",
		get_in_touch: "Get in touch",
		company: "The company",
		manager: "Manager",
		vat: "EU VAT ID",
		email: "Email",
		phone: "Phone",
		working_hours: "Working hours",
		my_time: "My current time",
		call: "Call",
		text: "Text",
		location_prefix: "This page was served from Cloudflare's ",
		location_edge: "global edge network",
		location_template: "{city} data center",
		location_suffix: ", probably the closest to you.",
	},
	sl: {
		title: "Kontakt | Reepolee",
		kicker: "Pozdravljeni",
		h1: "O, **pozdravljeni!**",
		h3: "Morda ste pričakovali obrazec. Izkazalo se je, da niso preveč **uporabni**. Nikoli ne veste, kam bodo **vaši podatki** končali po tem POST zahtevku in kdo vam bo naslednji dan začel pošiljati ponudbe, ki jih nikoli **niste želeli**.",
		p1: "Torej, ker smo tukaj sami **profesionalci**, odprite **e-pošto** in mi pošljite sporočilo ali uporabite **telefon** za SMS ali klic. E-pošta je verjetno boljša izbira.",
		get_in_touch: "Kontakti",
		company: "Podjetje",
		manager: "Odgovorna oseba",
		vat: "EU Davčna številka",
		email: "E-pošta",
		phone: "Telefon",
		working_hours: "Delovni čas",
		my_time: "Moj trenutni čas",
		call: "Klic",
		text: "SMS",
		location_prefix: "To stran je postregel Cloudflare iz ",
		location_edge: "svojega globalnega robnega omrežja",
		location_template: "podatkovnega centra {city}",
		location_suffix: ", verjetno najbližjega vam.",
	},
}[lang];
props.c = c;
props.page_title = c.title;
props.light_hero = true;
props.hero = { kicker: c.kicker, title: c.h1, subtitle: c.h3 + "\n\n" + c.p1, image: "/images/responsive/hero-contact.png", image_alt: "" };
}}
{#layout("layout")}

<main>
	<page-hero></page-hero>

	<div class="bg-warm py-g">
		<div class="container mx-auto">
			<div class="grid gap-16 lg:grid-cols-2 lg:gap-24">
				<div>
					<md-text type="h3" class="bold-strong">{~ props.c.get_in_touch }</md-text>
					<div class="mt-4 grid w-fit grid-cols-1 items-center gap-x-6 md:grid-cols-[auto_1fr] md:gap-y-1">
						<md-text type="text" class="mt-2">{~ props.c.email }</md-text>
						<md-text type="text" class="mt-2 font-semibold">**[hello@reepolee.com](mailto:hello@reepolee.com)**</md-text>
						<md-text type="text" class="mt-6 md:mt-2">{~ props.c.phone }</md-text>
						<md-text type="text" class="mt-2 font-semibold">**+386 51 807 939**</md-text>
						<md-text type="text" class="mt-6 md:mt-2">{~ props.c.working_hours }</md-text>
						<md-text type="text" class="mt-2 font-semibold tabular-nums">**09:00 - 17:00**</md-text>
						<md-text type="text" class="mt-6 md:mt-2">{~ props.c.my_time }</md-text>
						<div
							class="text-ink! mt-2 font-semibold tabular-nums prose"
							data-ljubljana-time
							data-locale="{= props.locale }"
							data-call="{= c.call }"
							data-text="{= c.text }"
							title="Europe/Ljubljana"
						>—</div>
					</div>
				</div>

				<div>
					<md-text type="h3" class="bold-strong">{~ props.c.company }</md-text>
					<md-text type="text" class="mt-4">Reepolee, računalniški inženiring, Aleš Vaupotič s.p.<br><br>Dunajska cesta 190<br>1000 Ljubljana<br>Slovenija</md-text>
				</div>

				<div class="lg:order-4">
					<md-text type="h3" class="bold-strong">{~ props.c.vat }</md-text>
					<md-text type="text" class="mt-4">**SI69983283**</md-text>
				</div>

				<div>
					<md-text type="h3" class="bold-strong">{~ props.c.manager }</md-text>
					<md-text type="text" class="mt-4">**Aleš Vaupotič**</md-text>

					<div class="mt-4 flex items-center gap-x-4">
						<a class="social-icons text-ink size-10 sm:size-14" href="https://www.linkedin.com/in/alesvaupotic/" target="_blank" rel="noopener noreferrer" aria-label="Aleš Vaupotič on LinkedIn">{#include('$components/svgs/linkedin.svg')}</a>
						<a class="social-icons text-ink size-10 p-1 sm:size-14" href="https://github.com/alesvaupotic/" target="_blank" rel="noopener noreferrer" aria-label="Aleš Vaupotič on Github">{#include('$components/svgs/github.svg')}</a>
						<a class="social-icons text-ink size-10 p-1 sm:size-14" href="https://x.com/alesvaupotic/" target="_blank" rel="noopener noreferrer" aria-label="Aleš Vaupotič on X">{#include('$components/svgs/x.svg')}</a>
						<a class="social-icons text-ink size-10 p-1 sm:size-14" href="https://bsky.app/profile/ales.reepolee.com" target="_blank" rel="noopener noreferrer" aria-label="Aleš Vaupotič on bsky.app">{#include('$components/svgs/bluesky.svg')}</a>
					</div>
				</div>
			</div>
		</div>
	</div>

	<div class="py-24 md:px-8">
		<div class="text-muted container mx-auto text-center text-lg text-balance lining-nums">
			{= c.location_prefix }<a href="https://speed.cloudflare.com" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline inline-flex items-center gap-x-1 align-middle transition-all"><span class="text-brand inline-flex w-4">{#include('$components/svgs/link.svg')}</span><span data-cf-edge data-cf-template="{= c.location_template }">{= c.location_edge }</span></a>{= c.location_suffix }
		</div>
	</div>
</main>
