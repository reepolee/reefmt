<!DOCTYPE html>
<html lang="{= props.lang }">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>{= props.page_title || props.title || "Reefmt — Reepolee Docs" }</title>
	<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
	<link rel="icon" href="/favicon.ico" sizes="any" />
	<meta name="description" content="{= props.description || "" }" />

	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@300;400;500&family=Instrument+Serif:ital@0;1&family=Montserrat:wght@100..900&display=swap" rel="stylesheet" />
	<link rel="stylesheet" href="/highlight-github-dark.min.css" />
	<link rel="stylesheet" href="/css/style.min.css" />

	{#if props.canonical_url}<link rel="canonical" href="{~ props.canonical_url }" />
	{/if}
	{#each props.hreflang_links as link}<link rel="alternate" hreflang="{= link.lang }" href="{~ link.href }" />
	{/each}
</head>
<body class="bg-paper text-ink font-sans antialiased">
	<!-- ── Top navigation ── -->
	<nav class="fixed top-0 left-0 right-0 z-50 bg-paper/90 backdrop-blur-md border-b border-divider">
		<div class="max-w-screen-2xl mx-auto flex items-center justify-between px-6 h-16">
			<a href="/reefmt/docs" class="flex items-center gap-2.5 group">
				<svg class="w-8 h-8 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 270 270">
					<circle cx="135" cy="135" r="135" fill="#B40000"/>
					<path d="M67 101C67 82.2223 82.2223 67 101 67H135V169C135 187.778 119.778 203 101 203H67V101Z" fill="white"/>
					<path d="M135 67H169C187.778 67 203 82.2223 203 101V101C203 119.778 187.778 135 169 135V135C150.222 135 135 119.778 135 101V67Z" fill="white" fill-opacity="0.5"/>
				</svg>
				<span class="text-xl font-bold tracking-tight">Reefmt</span>
			</a>
			<div class="flex items-center gap-4 ml-auto">
				<div class="hidden lg:flex items-center gap-2 text-sm font-bold">
					<a href="{~ props.helpers.localized_path('/') }" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Reepolee</a>
					<span class="text-muted/30">/</span>
					<a href="{~ props.helpers.localized_path('/blog') }" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Blog</a>
					<span class="text-muted/30">/</span>
					<a href="{~ props.helpers.localized_path('/enterprise') }" target="_blank" rel="noopener noreferrer" class="hover:text-accent transition-colors">Enterprise</a>
				</div>
				<div id="search-trigger" class="flex items-center gap-2 bg-warm rounded-lg px-2 py-1.5 text-xs text-muted whitespace-nowrap cursor-pointer hover:ring-2 hover:ring-accent/20 transition-all max-lg:hidden">
					<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
					<span>Search…</span>
					<kbd class="ml-auto text-[10px] bg-paper rounded px-1 py-0.5 font-mono border border-divider">⌘K</kbd>
				</div>
				<a href="https://github.com/reepolee/reefmt" target="_blank" rel="noopener noreferrer" class="whitespace-nowrap text-xs font-bold px-3 py-1.5 bg-accent text-white rounded-lg hover:bg-accent/80 transition-colors max-lg:hidden">Get Reefmt</a>
				<button id="mobile-nav-toggle" class="hidden max-lg:block cursor-pointer p-2" aria-label="Menu">
					<svg data-icon="menu" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 6h16M4 12h12M4 18h16"/></svg>
					<svg data-icon="close" hidden width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18M6 6l12 12"/></svg>
				</button>
			</div>
		</div>

		<!-- Mobile drawer -->
		<div id="mobile-drawer" hidden class="lg:hidden border-t border-divider bg-paper h-[calc(100vh-4rem)] overflow-y-auto">
			<div class="px-6 py-4 space-y-1">
				{#each props.docs_sidebar_groups as group}
					<div data-group="{= group.slug }">
						<button data-group-toggle="{= group.slug }" class="w-full flex items-center justify-between py-2 text-[11px] uppercase tracking-[0.15em] font-bold text-muted cursor-pointer">
							{= group.title }
							<svg data-group-chevron class="w-3 h-3 transition-transform duration-200 {= group.is_active ? 'rotate-180' : '' }" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
						</button>
						<div data-group-panel class="space-y-0.5" {= group.is_active ? '' : 'hidden' }>
							{#each group.links as link}
								<a data-mobile-link href="{~ link.url }" class="sidebar-link relative block text-sm py-1.5 pl-3 text-muted">{= link.title }</a>
							{/each}
						</div>
					</div>
				{/each}

				<div class="border-t border-divider pt-3 mt-3">
					<div class="relative">
						<svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
						<input id="mobile-search-input" type="search" placeholder="Search docs..." class="w-full rounded-lg border border-divider bg-paper py-2.5 pl-10 pr-4 text-sm placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-accent/20" />
					</div>
				</div>
				<div class="pt-3 mt-3 border-t border-divider space-y-1">
					<a data-mobile-link href="{~ props.helpers.localized_path('/') }" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm py-1.5 text-muted hover:text-ink transition-colors">Reepolee</a>
					<a data-mobile-link href="{~ props.helpers.localized_path('/blog') }" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm py-1.5 text-muted hover:text-ink transition-colors">Blog</a>
					<a data-mobile-link href="{~ props.helpers.localized_path('/enterprise') }" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm py-1.5 text-muted hover:text-ink transition-colors">Enterprise</a>
					<a href="https://github.com/reepolee/reefmt" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm py-1.5 text-muted hover:text-ink transition-colors">Reefmt<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
					<a href="https://github.com/reepolee/sqlfmt" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm py-1.5 text-muted hover:text-ink transition-colors">SQLfmt<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
					<a href="https://github.com/reepolee/reemerge" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm py-1.5 text-muted hover:text-ink transition-colors">Reemerge<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
					<a href="https://marketplace.visualstudio.com/items?itemName=reepolee.ree-templates" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 text-sm py-1.5 text-muted hover:text-ink transition-colors">VS Code Extension<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
				</div>
			</div>
		</div>
	</nav>

	<!-- Search modal -->
	<div id="search-modal" class="fixed inset-0 z-60 hidden" role="dialog" aria-modal="true">
		<div class="fixed inset-0 bg-black/50 backdrop-blur-sm" id="search-backdrop"></div>
		<div class="fixed inset-0 flex items-start justify-center pt-[15vh]">
			<div class="bg-paper rounded-xl border border-divider shadow-2xl w-full max-w-lg mx-4 overflow-hidden">
				<div class="relative">
					<svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
					<input id="search-input" type="search" placeholder="Search docs..." class="w-full border-0 border-b border-divider bg-transparent py-4 pl-12 pr-4 text-base placeholder:text-muted focus:outline-none" autocomplete="off" />
				</div>
				<div class="px-4 py-3 text-sm text-muted">Currently, the search is not yet implemented.</div>
			</div>
		</div>
	</div>

	<!-- Sticky mobile "On this page" -->
	{#if props.toc_headings && props.toc_headings.length > 0}
		<nav class="xl:hidden fixed top-16 left-0 right-0 z-40 bg-paper/90 backdrop-blur-md border-b border-divider">
			<div class="max-w-screen-2xl mx-auto px-6 flex items-center h-10">
				<button id="toc-toggle" class="flex items-center gap-2 cursor-pointer text-xs">
					<span class="text-[10px] uppercase tracking-[0.15em] font-bold text-muted">On this page</span>
					<svg data-toc-chevron class="w-3 h-3 text-muted transition-transform duration-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m6 9 6 6 6-6"/></svg>
				</button>
			</div>
			<div id="toc-drawer" hidden class="border-t border-divider bg-paper px-6 py-4 max-h-[calc(100vh-6.5rem)] overflow-y-auto">
				<div class="max-w-screen-2xl mx-auto flex flex-col gap-3 text-sm">
					{#each props.toc_headings as h}
						<a data-toc-link data-section="{= h.id }" href="#{= h.id }" class="transition-colors text-muted">{= h.text }</a>
					{/each}
				</div>
			</div>
		</nav>
	{/if}

	<div class="max-w-screen-2xl mx-auto flex pt-26 xl:pt-16">
		<!-- Left sidebar (desktop) -->
		<aside id="desktop-sidebar" class="sidebar max-lg:hidden w-64 shrink-0 sticky top-26 xl:top-16 h-[calc(100vh-6.5rem)] xl:h-[calc(100vh-4rem)] overflow-y-auto border-r border-divider px-6 py-8" style="scrollbar-gutter: stable;">
			<div class="space-y-8">
				{#each props.docs_sidebar_groups as group}
					<div data-desktop-group="{= group.slug }">
						<button data-desktop-toggle="{= group.slug }" class="w-full flex items-center justify-between text-[11px] uppercase tracking-[0.15em] font-bold text-muted mb-3 cursor-pointer">
							{= group.title }
							<span data-desktop-marker class="text-base leading-none">{= group.is_active ? '−' : '+' }</span>
						</button>
						<div data-desktop-panel class="space-y-0.5" {= group.is_active ? '' : 'hidden' }>
							{#each group.links as link}
								<a href="{~ link.url }" class="sidebar-link relative block text-sm py-1.5 pl-3 text-muted">
									<span class="toc-marker"></span>{= link.title }
								</a>
							{/each}
						</div>
					</div>
				{/each}

				<div class="pt-4 border-t border-divider space-y-2">
					<p class="text-[11px] uppercase tracking-[0.15em] font-bold text-muted/70">Reepolee tooling</p>
					<a href="https://github.com/reepolee/reefmt" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors">Reefmt<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
					<a href="https://github.com/reepolee/sqlfmt" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors">SQLfmt<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
					<a href="https://github.com/reepolee/reemerge" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors">Reemerge<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
					<a href="https://marketplace.visualstudio.com/items?itemName=reepolee.ree-templates" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1.5 text-sm text-muted hover:text-accent transition-colors">VS Code Extension<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg></a>
				</div>

				{#if props.reeweb_version || props.tailwind_version}
					<div class="pt-4 border-t border-divider space-y-1.5">
						{#if props.reeweb_version}
							<div class="flex items-center gap-2 text-xs text-muted">
								<span class="font-mono">Reeweb v{= props.reeweb_version }</span>
							</div>
						{/if}
						{#if props.tailwind_version}
							<div class="flex items-center gap-2 text-xs text-muted">
								<span>Tailwind v{= props.tailwind_version }</span>
							</div>
						{/if}
					</div>
				{/if}
			</div>
		</aside>

		<!-- Main content -->
		<main class="flex-1 min-w-0 px-8 lg:px-16 py-12 max-w-4xl">
			<!-- Alpha warning banner -->
			<div class="flex items-start gap-3 bg-warm border border-divider rounded-xl p-4 mb-8">
				<span class="shrink-0 mt-0.5 text-lg">⚠️</span>
				<div>
					<strong class="text-sm">Early Software</strong>
					<p class="text-sm text-muted">Reefmt is part of the Reepolee toolchain and under active development. Formatting output may change between releases.</p>
				</div>
			</div>
			{~ props.body }

			<!-- Footer: reepolee link + edit-on-GitHub -->
			<div class="mt-16 pt-8 border-t border-divider flex items-center justify-between">
				<a href="{~ props.helpers.localized_path('/') }" class="flex items-center gap-2 text-sm font-bold text-muted hover:text-accent transition-colors">
					<svg class="w-5 h-5" viewBox="0 0 270 270"><circle cx="135" cy="135" r="135" fill="currentColor"/><path d="M67 101C67 82.2223 82.2223 67 101 67H135V169C135 187.778 119.778 203 101 203H67V101Z" fill="white"/><path d="M135 67H169C187.778 67 203 82.2223 203 101V101C203 119.778 187.778 135 169 135V135C150.222 135 135 119.778 135 101V67Z" fill="white" fill-opacity="0.5"/></svg>
					reepolee.com
				</a>
				{#if props.edit_url}
					<a href="{= props.edit_url }" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm font-bold text-muted hover:text-accent transition-colors">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
						View on GitHub
					</a>
				{/if}
			</div>
		</main>

		<!-- Right TOC -->
		{#if props.toc_headings && props.toc_headings.length > 0}
			<aside class="hidden xl:block w-52 shrink-0 sticky top-16 h-[calc(100vh-4rem)] py-12 pr-6">
				<h4 class="text-[11px] uppercase tracking-[0.15em] font-bold text-muted mb-4">On this page</h4>
				<div class="space-y-2 text-xs">
					{#each props.toc_headings as h}
						<a data-rail-link data-section="{= h.id }" href="#{= h.id }" class="sidebar-link block pl-3 text-muted">{= h.text }</a>
					{/each}
				</div>
			</aside>
		{/if}
	</div>

	<script src="/js/signals-ui.js"></script>
	<script>
		// Detect the initially-expanded sidebar section from the DOM
		// (server-rendered based on is_active). This prevents the signal
		// effect from immediately overriding the correct initial state.
		const initial_desktop_group =
			Array.from(document.querySelectorAll("[data-desktop-panel]"))
				.find((p) => !p.hasAttribute("hidden"))
				?.closest("[data-desktop-group]")
				?.getAttribute("data-desktop-group") ?? "";
		const initial_active = "{= props.active_section || '' }";

		const mobile_nav = window.signal(false);
		const toc_open = window.signal(false);
		const active_section = window.signal(initial_active);
		const mobile_group = window.signal(initial_desktop_group);
		const desktop_group = window.signal(initial_desktop_group);

		// Mobile nav toggle button
		const nav_toggle = document.getElementById("mobile-nav-toggle");
		const drawer = document.getElementById("mobile-drawer");
		if (nav_toggle && drawer) {
			nav_toggle.addEventListener("click", () => mobile_nav(!mobile_nav()));
			window.bind_show(drawer, mobile_nav);
			window.bind_focus_trap(drawer, mobile_nav);
			window.bind_show(nav_toggle.querySelector('[data-icon="menu"]'), () => !mobile_nav());
			window.bind_show(nav_toggle.querySelector('[data-icon="close"]'), mobile_nav);
			drawer.addEventListener("scroll", () => sessionStorage.setItem("docsMobileNavScroll", drawer.scrollTop));
			window.effect(() => {
				if (mobile_nav()) queueMicrotask(() => {
					const saved = sessionStorage.getItem("docsMobileNavScroll");
					if (saved !== null) drawer.scrollTop = parseInt(saved, 10);
				});
			});
			drawer.querySelectorAll("[data-mobile-link]").forEach((a) => a.addEventListener("click", () => mobile_nav(false)));
			drawer.querySelectorAll("[data-group]").forEach((wrap) => {
				const slug = wrap.dataset.group;
				const panel = wrap.querySelector("[data-group-panel]");
				const chev = wrap.querySelector("[data-group-chevron]");
				wrap.querySelector("[data-group-toggle]").addEventListener("click", () => {
					mobile_group(mobile_group() === slug ? null : slug);
				});
				window.bind_collapse(panel, () => mobile_group() === slug);
				window.bind_class(chev, () => mobile_group() === slug, "rotate-180");
			});
		}

		// Mobile TOC drawer
		const toc_toggle = document.getElementById("toc-toggle");
		const toc_drawer = document.getElementById("toc-drawer");
		if (toc_toggle && toc_drawer) {
			toc_toggle.addEventListener("click", () => toc_open(!toc_open()));
			window.bind_show(toc_drawer, toc_open);
			window.bind_focus_trap(toc_drawer, toc_open);
			window.bind_class(toc_toggle.querySelector("[data-toc-chevron]"), toc_open, "rotate-180");
			toc_drawer.querySelectorAll("[data-toc-link]").forEach((a) => {
				a.addEventListener("click", () => toc_open(false));
				window.bind_class(a, () => active_section() === a.dataset.section, "text-accent");
				window.bind_class(a, () => active_section() === a.dataset.section, "font-semibold");
			});
		}

		// ── Search modal ──
		const search_modal = document.getElementById("search-modal");
		const search_trigger = document.getElementById("search-trigger");
		const search_input = document.getElementById("search-input");
		const search_backdrop = document.getElementById("search-backdrop");

		function openSearch() {
			if (!search_modal || !search_input) return;
			search_modal.classList.remove("hidden");
			queueMicrotask(() => search_input.focus());
		}

		function closeSearch() {
			if (!search_modal) return;
			search_modal.classList.add("hidden");
		}

		if (search_trigger) {
			search_trigger.addEventListener("click", openSearch);
		}
		if (search_backdrop) {
			search_backdrop.addEventListener("click", closeSearch);
		}

		document.addEventListener("keydown", (e) => {
			if ((e.metaKey || e.ctrlKey) && e.key === "k") {
				e.preventDefault();
				if (search_modal?.classList.contains("hidden")) {
					openSearch();
				} else {
					closeSearch();
				}
			}
			if (e.key === "Escape") {
				closeSearch();
				mobile_nav(false);
				toc_open(false);
			}
		});

		// Focus trap: keep Tab cycling within the modal
		if (search_modal) {
			search_modal.addEventListener("keydown", (e) => {
				if (e.key !== "Tab") return;
				const focusable = search_modal.querySelectorAll('input, button, [href], select, textarea, [tabindex]:not([tabindex="-1"])');
				if (focusable.length === 0) return;
				const first = focusable[0];
				const last = focusable[focusable.length - 1];
				if (e.shiftKey && document.activeElement === first) {
					e.preventDefault();
					last.focus();
				} else if (!e.shiftKey && document.activeElement === last) {
					e.preventDefault();
					first.focus();
				}
			});
		}

		// Desktop sidebar
		const sidebar = document.getElementById("desktop-sidebar");
		if (sidebar) {
			window.restore_scroll(sidebar, "docsSidebarScroll");
			sidebar.querySelectorAll("[data-desktop-group]").forEach((wrap) => {
				const slug = wrap.dataset.desktopGroup;
				const panel = wrap.querySelector("[data-desktop-panel]");
				const marker = wrap.querySelector("[data-desktop-marker]");
				const toggle = wrap.querySelector("[data-desktop-toggle]");
				toggle.addEventListener("click", () => {
					desktop_group(desktop_group() === slug ? "" : slug);
				});
				window.bind_collapse(panel, () => desktop_group() === slug);
				window.bind_text(marker, () => (desktop_group() === slug ? "−" : "+"));
				window.bind_attr(toggle, "aria-expanded", () => desktop_group() === slug);
			});
		}

		// Right rail TOC link active state
		document.querySelectorAll("[data-rail-link]").forEach((a) => {
			window.bind_class(a, () => active_section() === a.dataset.section, "active");
		});

		// Intersect-driven active section
		const toc_els = Array.from(document.querySelectorAll("[data-intersect]"));
		toc_els.forEach((el) => {
			window.on_intersect(el, () => active_section(el.dataset.intersect), {
				rootMargin: "-80px 0px -60% 0px",
			});
		});

		// Short-page fallback: activate the last section when scrolled to the bottom
		if (toc_els.length) {
			const last_toc_el = toc_els[toc_els.length - 1];
			const check_bottom = () => {
				if (window.scrollY + window.innerHeight >= document.body.scrollHeight - 100) {
					active_section(last_toc_el.dataset.intersect);
				}
			};
			check_bottom();
			window.addEventListener("scroll", check_bottom, { passive: true });
		}

		// Active sidebar link from current path
		{
			const path = window.location.pathname.replace(/\/$/, "") || "/";
			document.querySelectorAll(".sidebar-link").forEach((link) => {
				const href = (link.getAttribute("href") || "").replace(/\/$/, "") || "/";
				if (href === path) {
					link.classList.add("active");
					link.classList.remove("text-muted");
					link.classList.add("text-ink");
				}
			});
		}

		// Copy buttons for data-copy elements
		document.addEventListener("click", (e) => {
			const btn = e.target.closest("[data-copy]");
			if (!btn) return;
			navigator.clipboard.writeText(btn.dataset.copy).then(() => {
				btn.dataset.copied = "1";
				setTimeout(() => delete btn.dataset.copied, 1500);
			});
		});

		// Copy button injected into single-line <pre><code> blocks
		const copyIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>`;
		const checkIcon = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 12 9 17 20 7"/></svg>`;
		document.querySelectorAll("pre").forEach((pre) => {
			const code = pre.querySelector("code");
			if (!code) return;
			const text = code.innerText.trim();
			if (text.includes("\n")) return;
			pre.style.position = "relative";
			const btn = document.createElement("button");
			btn.title = "Copy";
			btn.innerHTML = copyIcon;
			btn.style.cssText = "position:absolute;right:12px;top:50%;transform:translateY(-50%);padding:4px;border-radius:6px;color:rgba(255,255,255,0.4);background:transparent;border:none;cursor:pointer;transition:color 0.15s,background 0.15s;line-height:0;";
			btn.addEventListener("mouseenter", () => {
				btn.style.color = "rgba(255,255,255,0.9)";
				btn.style.background = "rgba(255,255,255,0.1)";
			});
			btn.addEventListener("mouseleave", () => {
				btn.style.color = "rgba(255,255,255,0.4)";
				btn.style.background = "transparent";
			});
			btn.addEventListener("click", () => {
				navigator.clipboard.writeText(text).then(() => {
					btn.innerHTML = checkIcon;
					btn.style.color = "rgb(74,222,128)";
					setTimeout(() => {
						btn.innerHTML = copyIcon;
						btn.style.color = "rgba(255,255,255,0.4)";
					}, 2000);
				});
			});
			pre.appendChild(btn);
		});
	</script>
</body>
</html>
