{#layout("layout")}
{{
const title = props.title || "Blog";
props.page_title = title + " | Reepolee";
const excerpt = props.description || props.excerpt || "";
const author = props.author || "";
const locale = props.locale || "en";
const date_str = props.published_at ? props.helpers.js_date_to_locale_string(props.published_at, locale) : "";
const image = props.image || props.hero_image || "";
// Author · date becomes the hero kicker (the light editorial post header).
const kicker = author ? (date_str ? `${author} · ${date_str}` : author) : date_str;
props.light_hero = true;
props.hero = { kicker, title, subtitle: excerpt, image, image_alt: title };
}}

<main>
	<page-hero></page-hero>
	<div class="py-g container mx-auto blog-article">
		{~ props.body }
	</div>
</main>
