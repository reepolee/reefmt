{#layout("layout")}
{{
const c = {
	en: {
		title: "Results | Reepolee",
		kicker: "Case studies",
		h1: "**Results**, not promises",
		h2: "Outcomes we've delivered for teams in the **public and private sector** — the proof behind the philosophy. Every project is a story about **reducing risk** and **handing back ownership**.",
		read_more: "Read the story",
		lets_talk: "Let's talk",
	},
	sl: {
		title: "Rezultati | Reepolee",
		kicker: "Študije primerov",
		h1: "**Rezultati**, ne obljube",
		h2: "Dosežki, ki smo jih dosegli za ekipe v **javnem in zasebnem sektorju** — dokaz za filozofijo. Vsak projekt je zgodba o **zmanjševanju tveganja** in **vračanju lastništva**.",
		read_more: "Preberi zgodbo",
		lets_talk: "Kontakt",
	},
}[lang];
props.c = c;
props.page_title = c.title;
props.light_hero = true;
props.hero = { kicker: c.kicker, title: c.h1, subtitle: c.h2, image: "/images/responsive/hero-results.png", image_alt: "" };
}}

<main>
	<page-hero></page-hero>
	<div class="pb-g container mx-auto">
		<results-grid></results-grid>
		<div class="mt-12 flex md:mt-24">
			<link-button href="/contact" class="primary">{~ props.c.lets_talk }</link-button>
		</div>
	</div>
</main>
