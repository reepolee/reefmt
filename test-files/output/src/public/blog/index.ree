{#layout("layout")}
{{
const c = {
	en: {
		kicker: "Writing",
		title: "**Blog**",
		subtitle: "Two tracks: writing that makes developers **fall in love** with building this way, and pieces that **arm them to sell it up** internally.",
	},
	sl: {
		kicker: "Zapisi",
		title: "**Blog**",
		subtitle:
			"Dve temi: pisanje, ki v razvijalcih vzbudi **ljubezen** do tega načina dela, in prispevki, ki jim pomagajo to **prodati navzgor** v organizaciji.\n\n*Prispevki na blogu so na voljo samo v angleščini.*",
	},
}[lang];
props.c = c;
props.page_title = "Blog | Reepolee";
props.light_hero = true;
props.hero = { kicker: c.kicker, title: c.title, subtitle: c.subtitle, image: "/images/responsive/hero-blog.png", image_alt: "" };
}}

<main>
	<page-hero></page-hero>

	<div class="py-g container mx-auto">
		<!-- grid-rows-subgrid: image / date / title / excerpt / CTA rows share track
		     heights across cards, so titles, excerpts and the Read CTA line up no
		     matter how long each post's copy is. Card sets its own row-gap; the 2rem
		     band gap between card rows comes from the parent grid. -->
		<div class="grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3">
			{#each props.records as post}
				<a href="{~ localized_path('/blog/' + post.slug) }" class="group row-span-5 grid grid-rows-subgrid gap-y-3 overflow-hidden rounded-lg border border-divider bg-warm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl">
					<!-- Duotone cover photo with a track chip -->
					<div class="relative h-48 overflow-hidden">
						<responsive-image src="{= post.image }" alt="{= post.title }" image_class="h-full w-full object-cover saturate-[0.85] transition-transform duration-500 group-hover:scale-105" sizes="(max-width: 768px) 100vw, 33vw"></responsive-image>
						<div class="absolute inset-0 bg-brand/15 mix-blend-multiply"></div>
						<div class="absolute inset-0 bg-linear-to-t from-ink/35 to-transparent"></div>
						<span class="absolute top-4 left-4 rounded-full bg-ink/80 px-3 py-1 text-xs font-semibold tracking-wide text-white uppercase backdrop-blur-sm">{= post.track }</span>
					</div>
					<time class="text-muted px-7 pt-5 text-xs font-semibold tracking-wide uppercase">{= post.date }</time>
					<div class="px-7 text-xl font-semibold lg:text-2xl">{= post.title }</div>
					<md-text type="text" class="px-7 text-base lg:text-base" text="{= post.excerpt }"></md-text>
					<div class="text-brand inline-flex items-center gap-x-3 px-7 pb-7 font-semibold">
						<span>Read</span>
						<re-arrow direction="right" class="h-6 w-6 transition-transform group-hover:translate-x-1"></re-arrow>
					</div>
				</a>
			{/each}
		</div>

		{#if props.pagination}
			<div class="mt-12">
				{#if props.pagination_variant === 'simple'}
					<simple-pagination data="{= props.pagination }"></simple-pagination>
				{:else}
					<full-pagination data="{= props.pagination }"></full-pagination>
				{/if}
			</div>
		{/if}
	</div>
</main>
