{{
// Reusable light editorial page hero — ported from the approved homepage hero.
// The page sets `props.hero = { kicker, title, subtitle, image, image_alt, ctas }`
// and `props.light_hero = true` (so the layout renders the nav with ink text).
//   - title / subtitle are inline markdown (bold becomes the red italic accent).
//   - ctas: [{ href, label, primary? }] — `primary` renders a solid-red button.
//   - image (optional): a path like "/images/responsive/hero-2.png". When present
//     the hero is an asymmetric two-column layout with a duotone image panel on
//     the right; without it the hero is a single left-aligned column.
// NOTE: title/CTAs are rendered as plain HTML (not via <md-text>/<link-button>)
// because custom-element *slots* run in an isolated scope that can't see locals
// like `h`/`cta`; component-scope markup (incl. loop bodies) can.
// pt-* reserves the fixed-nav band so the image panel never sits under the nav.
const h = props.hero || {};
const ctas = h.ctas || [];
const has_image = !!h.image;
}}
<div class="hero-bg min-h-page-hero flex items-center pt-28 pb-16 lg:pt-32">
	<div class="container mx-auto w-full">
		<div class="grid items-center gap-12{~ has_image ? ' lg:grid-cols-[1.05fr_0.95fr] lg:gap-16' : '' }">
			<!-- Copy -->
			<div class="flex flex-col items-start">
				{#if h.kicker}
					<div class="mb-6 flex items-center gap-x-4 text-sm font-semibold tracking-[0.2em] text-brand uppercase">
						<span class="h-px w-10 bg-brand"></span>
						<span>{= h.kicker }</span>
					</div>
				{/if}
				<h1 class="heading prose max-w-[18ch] text-left text-balance text-5xl sm:text-6xl lg:text-7xl">{~ md(h.title) }</h1>
				{#if h.subtitle}
					<div class="prose mt-6 max-w-2xl text-lg text-balance lg:text-xl">{~ md(h.subtitle) }</div>
				{/if}
				{#if ctas.length > 0}
					<div class="mt-10 flex flex-col gap-4 sm:flex-row">
						{#each ctas as cta}
							{{ const _ext = typeof cta.href === "string" && cta.href.startsWith("http"); const _href = _ext ? cta.href : localized_path(cta.href); }}
							<a href="{= _href }"{~ _ext ? ' target="_blank" rel="noopener noreferrer"' : '' } class="{~ cta.primary ? 'primary border border-transparent text-white' : 'border border-divider' } flex w-fit items-center gap-x-4 rounded px-6 py-3 font-semibold transition-all hover:bg-black/5">
								<span>{= cta.label }</span>
								<re-arrow direction="right" class="h-8 w-8"></re-arrow>
							</a>
						{/each}
					</div>
				{/if}
			</div>
			<!-- Duotone image panel with desktop-only offset red frame -->
			{#if has_image}
				<div class="relative">
					<div class="absolute -right-6 -bottom-6 hidden h-2/3 w-2/3 rounded-2xl border border-brand/40 lg:block"></div>
					<div class="relative h-64 overflow-hidden rounded-2xl border border-divider shadow-xl sm:h-72 lg:h-96 xl:h-104">
						<responsive-image src="{= h.image }" alt="{= h.image_alt || '' }" loading="eager" image_class="h-full w-full object-cover" sizes="(max-width: 1024px) 100vw, 600px"></responsive-image>
						<div class="absolute inset-0 bg-brand/15 mix-blend-multiply"></div>
					</div>
				</div>
			{/if}
		</div>
	</div>
</div>
