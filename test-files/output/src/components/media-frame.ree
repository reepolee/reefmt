{{
// Labeled placeholder frame for imagery that doesn't exist yet (product
// screenshots, site galleries). A styled aspect-ratio box with an offset red
// accent frame (echoing page-hero) and a centered caption marking what asset
// belongs here. Props-only — custom-element slots run in an isolated scope, so
// nothing here depends on page locals; callers pass everything via attributes.
//   - label: caption text, e.g. "screenshot — dashboard"
//   - ratio: aspect ratio, e.g. "16/9" (default), "4/3", "1/1"
//   - class: extra classes on the outer wrapper
const a = props.attributes || {};
const _label = a.label || "";
const _ratio = a.ratio || "16/9";
const _class = a.class || "";
const final_class = tw_merge("relative", _class);
}}
<div class="{= final_class }">
	<div class="absolute -right-4 -bottom-4 hidden h-2/3 w-2/3 rounded-2xl border border-brand/40 lg:block"></div>
	<div class="bg-warm border-divider relative flex items-center justify-center overflow-hidden rounded-2xl border shadow-sm" style="aspect-ratio: {= _ratio };">
		<div class="flex flex-col items-center gap-3 p-6 text-center">
			<div class="text-brand/60 h-10 w-10"><img src="/ree-file.svg" alt="" class="h-full w-full opacity-50" /></div>
			{#if _label}
				<div class="text-muted font-mono text-xs tracking-wide uppercase">{= _label }</div>
			{/if}
		</div>
	</div>
</div>
