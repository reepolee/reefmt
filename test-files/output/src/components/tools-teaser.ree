{{
// Homepage Tools teaser (developer hook). Self-contained custom element:
// reads props.products + props.home from the render context.
const t = props.home[lang] || {};
const products = props.products[lang] || [];
const a = products[0] || {};
const b = products[1] || {};
}}
<div class="bg-warm py-g" style="content-visibility: auto; contain-intrinsic-size: auto 600px;">
	<div class="container mx-auto text-ink">
		<h2 class="heading prose text-balance text-4xl lg:text-5xl">{~ md(t.tools_h2) }</h2>
		<div class="prose mt-8 max-w-3xl text-base text-balance lg:text-lg">{~ md(t.tools_intro) }</div>

		<div class="mt-12 flex flex-col gap-8 md:mt-24 lg:flex-row lg:items-stretch">
			<a href="{~ localized_path(a.href) }" class="group flex flex-1 flex-col gap-y-4 border-t border-divider p-8 transition-all hover:bg-black/5">
				<media-frame label="{= a.caption }" ratio="16/9"></media-frame>
				<div class="flex items-center justify-between">
					<div class="text-2xl font-semibold lg:text-3xl">{= a.name }</div>
					<span class="rounded-full border border-divider px-3 py-1 text-sm font-semibold">{= a.badge }</span>
				</div>
				<div class="prose text-base font-normal text-balance lg:text-lg">{~ md(a.tagline) }</div>
				<div class="mt-2 inline-flex items-center gap-x-3 font-semibold text-brand">
					<span>{= a.cta }</span>
					<re-arrow direction="right" class="h-6 w-6"></re-arrow>
				</div>
			</a>

			<div class="flex items-center justify-center">
				<re-arrow direction="right" class="h-10 w-10 rotate-90 lg:rotate-0"></re-arrow>
			</div>

			<a href="{~ localized_path(b.href) }" class="group flex flex-1 flex-col gap-y-4 border-t border-divider p-8 transition-all hover:bg-black/5">
				<media-frame label="{= b.caption }" ratio="16/9"></media-frame>
				<div class="flex items-center justify-between">
					<div class="text-2xl font-semibold lg:text-3xl">{= b.name }</div>
					<span class="rounded-full border border-divider px-3 py-1 text-sm font-semibold">{= b.badge }</span>
				</div>
				<div class="prose text-base font-normal text-balance lg:text-lg">{~ md(b.tagline) }</div>
				<div class="mt-2 inline-flex items-center gap-x-3 font-semibold text-brand">
					<span>{= b.cta }</span>
					<re-arrow direction="right" class="h-6 w-6"></re-arrow>
				</div>
			</a>
		</div>

		<div class="prose mt-8 text-sm text-balance italic">{~ md(t.tools_engine_line) }</div>

		<!-- The rest of the toolbox — mirrors the tools page + docs-index ecosystem cards -->
		<div class="border-divider mt-16 border-t pt-16 md:mt-24">
			<h3 class="text-2xl font-semibold lg:text-3xl">{= t.tools_more_h }</h3>
			<div class="prose mt-6 max-w-3xl text-base text-balance lg:text-lg">{~ md(t.tools_more_intro) }</div>

			<div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
				{#each t.tools_more as tool}
					<a href="{~ localized_path(tool.href) }" class="group bg-paper flex flex-col gap-3 rounded-xl p-6 transition-all hover:ring-2 hover:ring-brand/20">
						<div class="flex items-center justify-between">
							<img src="/ree-file.svg" alt="" class="h-8 w-8 shrink-0" />
							<span class="border-divider text-muted rounded-full border px-2.5 py-0.5 text-xs font-semibold">{= tool.badge }</span>
						</div>
						<div class="group-hover:text-brand mt-1 text-lg font-semibold transition-colors">{= tool.name }</div>
						<div class="text-muted text-sm leading-relaxed">{= tool.desc }</div>
						<div class="text-brand mt-2 inline-flex items-center gap-x-2 text-sm font-semibold">
							<span>{= t.tools_more_cta }</span>
							<re-arrow direction="right" class="h-4 w-4"></re-arrow>
						</div>
					</a>
				{/each}
			</div>
		</div>

		<div class="mt-12">
			<a href="{~ localized_path('/tools') }" class="flex w-fit items-center gap-x-4 rounded border border-divider px-6 py-3 font-semibold transition-all hover:bg-black/5">
				<span>{= t.tools_all }</span>
				<re-arrow direction="right" class="h-6 w-6"></re-arrow>
			</a>
		</div>
	</div>
</div>
