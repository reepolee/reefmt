{#layout("layout")}

<div class="p-4 grid gap-4">
	<h1>{= props.ui.title }</h1>
	<h2>{= props.ui.description }</h2>
	<p>{= props.site_name } © Reepolee {= props.year }</p>

	{= props.show_demo_text }

	{#if props.show_demo_text}
		<div class="rounded-lg border-2 border-dashed border-amber-400 bg-amber-50 p-6 text-center">
			<p class="text-lg font-bold text-amber-800">🎉 Feature flag activated!</p>
			<p class="text-amber-700">
				You're seeing this because the <code class="font-mono text-amber-900">show_about_demo_text</code> flag resolved to <strong>true</strong>
				for this request (50% rollout via Redis).
			</p>
		</div>
	{/if}

	<div class="mt-64"></div>

	<app-banner type="red">Banner test</app-banner>
	<app-banner type="yellow">Banner test</app-banner>
	<app-banner type="green">Banner test</app-banner>
	<app-banner>Banner test</app-banner>

	<button class="button mt-4 border max-w-auto mx-auto" id="notify-btn">Force System notification</button>
</div>

<script>
	const button = document.querySelector("#notify-btn");
	button.addEventListener("click", async () => {
		const permission = await Notification.requestPermission();
		if (permission === "granted") {
			new Notification("Hey! ", {
				body: "Your report is ready to download.",
				icon: "/favicon.svg",
			});
		}
	});
</script>
