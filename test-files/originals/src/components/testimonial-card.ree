{{
// Port of <Testimonial>. Receives a testimonial object via the `item` attribute.
const a = props.attributes || {};
const it = a.item || {};
const _class = a.class || "text-5xl font-semibold";
const person = it.person || "";
const photo = it.photo || "";
const linkedin_url = it.linkedin_url || "";
const company_linkedin_url = it.company_linkedin_url || "";
const logo = it.logo || "";
const company_url = it.company_url || "";
const title = it.title || "";
const company = it.company || "";
const slug = it.slug || "";
const content = it.content || "";
}}
<div class="testimonial grid scroll-mt-36 grid-rows-[1fr_auto] gap-x-6 gap-y-4 rounded-lg border border-divider bg-warm p-6 sm:gap-y-12 sm:p-11 {= _class } w-full lg:w-[800px] 2xl:w-[960px]" id="{= slug }">
	<div class="text-lg font-semibold text-balance xl:text-2xl">
		“{~ content }”
	</div>

	<div class="flex flex-col md:flex-row md:items-center md:justify-between">
		<div class="flex max-w-xl flex-col justify-between gap-x-4 gap-y-4 opacity-80 sm:flex-row sm:items-center sm:pl-2">
			<responsive-image src="{= photo }" alt="{= person }" class="h-28 w-28 rounded-xl" sizes="300px" image_class="object-cover rounded-xl"></responsive-image>

			<div class="flex flex-1 flex-col">
				<div class="text-xl leading-8 font-semibold">{= person }</div>
				<div class="text-base font-normal">{= title }</div>
				{#if linkedin_url.length > 0 || company_url.length > 0}
					<div class="mt-2 flex items-center gap-x-2">
						{#if linkedin_url.length > 0}
							<a class="social-icons size-7 sm:size-8" href="{= linkedin_url }" aria-label="{= person } LinkedIn" title="{= person }">{#include('$components/svgs/linkedin.svg')}</a>
						{/if}
						{#if company_linkedin_url.length > 0}
							<a class="social-icons size-7 sm:size-8" href="{= company_linkedin_url }" aria-label="{= company } LinkedIn" title="{= company }">{#include('$components/svgs/linkedin.svg')}</a>
						{/if}
						{#if company_url.length > 0}
							<a class="social-icons size-7 sm:size-8" href="{= company_url }" aria-label="{= company } web site">{#include('$components/svgs/www.svg')}</a>
						{/if}
					</div>
				{/if}
			</div>
		</div>
		{#if logo.length > 0}
			<a class="mt-6 mr-2 h-8 sm:h-12 md:mt-0 md:self-end" href="{= company_url }" aria-label="{= company } logo">
				<img src="{= logo }" alt="{= company }" class="h-full object-contain object-left transition-all hover:opacity-40 md:object-right" loading="lazy" height="48" width="250" />
			</a>
		{/if}
	</div>
</div>
