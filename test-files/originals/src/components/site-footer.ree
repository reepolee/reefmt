{{
// Port of <Footer>. Reads labels from props.footer / props.nav translations.
const f = props.footer || {};
const n = props.nav || {};
const site_version = "1.6.19";
}}
<div class="text-ink container mx-auto pt-16 text-center md:pt-24">
	<div class="mt-16 flex w-full items-center justify-center gap-10 text-center">
		<a class="social-icons size-12" href="https://si.linkedin.com/in/alesvaupotic" target="_blank" rel="noopener noreferrer" aria-label="Ales' LinkedIn">{#include('$components/svgs/linkedin.svg')}</a>
		<a class="social-icons size-12" href="https://github.com/reepolee/" target="_blank" rel="noopener noreferrer" aria-label="Company Github">{#include('$components/svgs/github.svg')}</a>
		<a class="social-icons size-12" href="https://x.com/alesvaupotic" target="_blank" rel="noopener noreferrer" aria-label="Ales' X profile">{#include('$components/svgs/x.svg')}</a>
		<a class="social-icons size-12" href="https://bsky.app/profile/ales.reepolee.com" target="_blank" rel="noopener noreferrer" aria-label="Aleš Vaupotič on bsky.app">{#include('$components/svgs/bluesky.svg')}</a>
	</div>

	<div class="mt-16 flex w-full flex-col items-center justify-center">
		<div class="size-20 lg:size-40">{#include('$components/svgs/reepolee-logo.svg')}</div>
		<div class="text-2xl font-semibold md:text-5xl lg:text-7xl">reepolee</div>
	</div>

	<div class="mt-16 leading-6 text-balance">
		<p>Reepolee, računalniški inženiring, Aleš Vaupotič s.p.</p>
		<p>Dunajska cesta 190, 1000 Ljubljana, Slovenija</p>
		<p>{= f.vat } SI69983283</p>
	</div>

	<div class="border-divider mt-24 border-t" id="end-of-page">
		<div class="flex flex-col justify-between gap-6 py-6 text-sm font-semibold uppercase lg:flex-row">
			<div class="flex flex-col gap-x-4 gap-y-6 lg:flex-row">
				<div>v{= site_version } © Reepolee {= props.year }</div>
				<span class="text-divider hidden font-normal lg:block">/</span>
				<a href="{~ localized_path('/cookie-policy') }">{= f.cookies }</a>
				<span class="text-divider hidden font-normal lg:block">/</span>
				<a href="{~ localized_path('/privacy-policy') }">{= f.privacy }</a>
				<span class="text-divider hidden font-normal lg:block">/</span>
				<a href="{~ localized_path('/media-kit') }">{= f.media }</a>
			</div>
		</div>
	</div>
</div>
