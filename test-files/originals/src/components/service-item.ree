{{
// Port of <ServiceItem>. Per-item data arrives via interpolated attributes.
const a = props.attributes || {};
const _idx = parseInt(a.id ?? 0) + 1;
const __id = _idx < 10 ? "0" + _idx : "" + _idx;
const _title = a.title || "";
const _content = a.content || "";
const _class = a.class || "text-2xl lg:text-5xl font-semibold";
}}
<div class="service-item border-divider grid gap-x-6 gap-y-4 border-t py-8 lg:py-12 {= _class }">
	<div class="text-muted">{= __id }</div>
	<div class="flex w-full items-center justify-between text-3xl lg:text-5xl">
		<div>
			<div class="heading flex-1">{= _title }</div>
			<div class="col-span-2 col-start-1 mt-4">
				<md-text type="text" class=" font-normal" text="{= _content }"></md-text>
			</div>
		</div>
	</div>
</div>
