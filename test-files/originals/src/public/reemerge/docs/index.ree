{#layout("reemerge/docs/docs.layout")}

{#if lang === 'sl'}
<div class="mb-12 rounded-xl border border-divider bg-warm p-5">
	<p class="text-muted">Dokumentacija za Reemerge je na voljo samo v angleščini.</p>
</div>
{/if}

<!-- Introduction -->
<section id="introduction" data-intersect="introduction" class="scroll-mt-30 fade-in">
	<div class="flex items-center gap-3 mb-2">
		<span class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-badge bg-badge-light rounded-full px-3 py-1">
			<span class="w-1.5 h-1.5 rounded-full bg-badge"></span>
			Reepolee tooling
		</span>
		<span class="text-xs text-muted font-mono">written in Rust</span>
	</div>
	<h1 class="font-display text-5xl lg:text-6xl italic leading-[1.05] mb-6">
		Hand-pick your way<br/>
		<span class="text-accent">to a clean pull request.</span>
	</h1>
	<p class="text-lg leading-relaxed text-muted max-w-2xl mb-8">
		Reemerge is an interactive cherry-pick tool for preparing hand-selected branches for pull requests. Fuzzy-select a source branch, choose exactly which commits — and even which files within each commit — to bring across, preview the diff, and apply it all onto a clean PR branch off <code class="font-mono text-sm bg-warm px-1.5 py-0.5 rounded border border-divider">main</code>.
	</p>

	<!-- Feature cards -->
	<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-16">
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="text-2xl mb-3">🍒</div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Commit & file granularity</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">Multi-select the commits you want, then deselect individual files within each one. Split a sprawling branch into focused PRs.</p>
		</div>
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="text-2xl mb-3">⚡</div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Native speed</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">A single Rust binary with prebuilt releases for macOS, Linux and Windows. No runtime, no node_modules.</p>
		</div>
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="text-2xl mb-3">🔍</div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Diff preview</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">Review every change before it lands, and let Reemerge handle merge commits automatically. Optionally push the new branch when you're done.</p>
		</div>
	</div>
</section>

<hr class="border-divider mb-12" />

<!-- Quick start -->
<section id="quick-start" data-intersect="quick-start" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Quick start</h2>
	<p class="text-muted leading-relaxed mb-6">
		Install the binary, then run Reemerge from inside any git repository. It walks you through selecting branches, commits and files interactively.
	</p>

	<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4 mb-4">
		<code class="font-mono text-sm" style="color:#e2e0d8">curl -fsSL https://raw.githubusercontent.com/reepolee/reemerge/main/install.sh | bash</code>
		<button type="button" data-copy="curl -fsSL https://raw.githubusercontent.com/reepolee/reemerge/main/install.sh | bash" class="shrink-0 ml-auto cursor-pointer" title="Copy">
			<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
			<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
		</button>
	</div>

	<p class="text-muted leading-relaxed">
		Head to <a href="/reemerge/docs/getting-started/installation" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">Installation</a> for every install option, then see <a href="/reemerge/docs/usage/command-line" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">the interactive workflow</a> for a step-by-step walkthrough.
	</p>
</section>

<hr class="border-divider mb-12" />

<!-- Ecosystem -->
<section id="ecosystem" data-intersect="ecosystem" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Explore the ecosystem</h2>
	<p class="text-muted leading-relaxed mb-6">
		Reepolee is a small family of tools that work together. Explore the others — each has its own documentation.
	</p>

	<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
		<a href="/reepolee/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reepolee</p>
				<p class="text-xs text-muted">Full-stack framework</p>
			</div>
		</a>
		<a href="/reeweb/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reeweb</p>
				<p class="text-xs text-muted">Static site generator</p>
			</div>
		</a>
		<a href="/reefmt/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reefmt</p>
				<p class="text-xs text-muted">.ree template formatter</p>
			</div>
		</a>
		<a href="/sqlfmt/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">SQLfmt</p>
				<p class="text-xs text-muted">SQL formatter</p>
			</div>
		</a>
		<a href="/ree-templates-vscode/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Ree Templates for VSCode</p>
				<p class="text-xs text-muted">Formatter &amp; syntax highlighter</p>
			</div>
		</a>
	</div>
</section>
