{#layout("layout")}
{{
const c = {
	en: {
		title: "Reeweb | Reepolee",
		kicker: "Static site generator",
		h1: "Ship fast static sites<br>**without the framework tax**",
		promise: "Reeweb turns .ree templates and markdown into a fast, multi-language static site — i18n, RSS and sitemaps included. Zero runtime dependencies. The easy first rung.",
		docs: "Get started",
		github: "GitHub",

		proof_kicker: "Trusted in production",
		proof_line: "Powering marketing sites, docs and blogs that ship in hours, not sprints.",
		proof_logos: [
			{ caption: "logo — agency" },
			{ caption: "logo — saas" },
			{ caption: "logo — studio" },
			{ caption: "logo — public sector" },
			{ caption: "logo — startup" },
		],

		why_h: "Why teams choose Reeweb",
		why_intro: "Less to learn, less to maintain, nothing to outgrow before you're ready.",
		why: [
			{ title: "Zero runtime dependencies", desc: "A tiny dependency tree and no framework churn to keep up with. Your site keeps building in five years.", caption: "diagram — dependency tree" },
			{ title: "One engine, top to bottom", desc: "The same .ree templating you'd use in the full framework — learn it once, reuse it everywhere.", caption: "screenshot — .ree template" },
			{ title: "Bun-native today", desc: "Fast builds and a tiny toolchain. The runtime we back right now, never baked into the name.", caption: "screenshot — build output" },
		],

		features_h: "Everything a content site needs",
		features_intro: "Batteries included for the things every real site ends up needing — without reaching for plugins.",
		features: [
			{ title: "Built-in i18n", desc: "Per-language routing and translations with cross-language fallback. Ship en- and sl- routes from one source.", caption: "screenshot — language routing" },
			{ title: "Markdown content", desc: "Author posts and pages in markdown with front-matter. Code highlighting and prose styling come standard.", caption: "screenshot — markdown post" },
			{ title: "RSS & sitemaps", desc: "Feeds and sitemaps generated at build time, localized correctly, so search and readers stay in sync.", caption: "screenshot — generated sitemap" },
			{ title: ".ree components", desc: "Compose pages from small, reusable components — the same minimal, familiar templating engine throughout.", caption: "screenshot — component library" },
		],

		how_h: "Up and running in minutes",
		how_intro: "Install, run the dev server, build. That's the whole loop.",
		steps: [
			{ n: "01", title: "Install", desc: "Add Reeweb to your project — one tiny dependency, Bun-native." },
			{ n: "02", title: "Author", desc: "Write .ree templates and markdown. Live reload as you go." },
			{ n: "03", title: "Build & deploy", desc: "Produce a static bundle and ship it to any CDN or static host." },
		],
		code: "bun install\nbun run dev\nbun run build",

		built_h: "Built with Reeweb",
		built_intro: "A few of the sites and projects running on it. Yours could be next.",
		built_with: [
			{ caption: "screenshot — marketing site" },
			{ caption: "screenshot — docs site" },
			{ caption: "screenshot — blog" },
			{ caption: "screenshot — landing page" },
			{ caption: "screenshot — portfolio" },
			{ caption: "screenshot — event site" },
		],

		quote: "We replaced a heavy framework with Reeweb and our build went from minutes to seconds. There's simply less to go wrong.",
		quote_by: "Placeholder testimonial — engineering lead",

		ladder_h: "Outgrowing static?",
		ladder: "When a project needs a database, auth or a backoffice, move up to the Reepolee framework — same engine, same conventions, more power.",
		ladder_cta: "See the framework",

		cta_h: "Want help adopting it?",
		cta: "We can help you adopt Reeweb as your team's baseline for static sites and get the most out of it.",
		results_cta: "See the results",
		talk_cta: "Talk to Reepolee",
	},
	sl: {
		title: "Reeweb | Reepolee",
		kicker: "Generator statičnih strani",
		h1: "Hitre statične strani<br>**brez davka na ogrodje**",
		promise: "Reeweb iz .ree predlog in markdowna ustvari hitro, večjezično statično stran — i18n, RSS in sitemapi vključeni. Brez odvisnosti ob izvajanju. Enostavna prva stopnička.",
		docs: "Začni",
		github: "GitHub",

		proof_kicker: "Preizkušeno v produkciji",
		proof_line: "Poganja predstavitvene strani, dokumentacijo in bloge, ki nastanejo v urah, ne v tednih.",
		proof_logos: [
			{ caption: "logotip — agencija" },
			{ caption: "logotip — saas" },
			{ caption: "logotip — studio" },
			{ caption: "logotip — javni sektor" },
			{ caption: "logotip — startup" },
		],

		why_h: "Zakaj ekipe izberejo Reeweb",
		why_intro: "Manj za naučiti, manj za vzdrževati, nič, kar bi prerasli, preden ste pripravljeni.",
		why: [
			{ title: "Brez odvisnosti ob izvajanju", desc: "Majhno drevo odvisnosti in brez nenehnih nadgradenj ogrodij. Stran se bo gradila tudi čez pet let.", caption: "diagram — drevo odvisnosti" },
			{ title: "En pogon od vrha do dna", desc: "Iste .ree predloge kot v polnem ogrodju — naučiš se enkrat, uporabljaš povsod.", caption: "posnetek — .ree predloga" },
			{ title: "Danes Bun-native", desc: "Hitre gradnje in majhna orodjarna. Runtime, ki ga podpiramo zdaj, nikoli vgrajen v ime.", caption: "posnetek — izpis gradnje" },
		],

		features_h: "Vse, kar vsebinska stran potrebuje",
		features_intro: "Vključeno za vse, kar vsaka prava stran na koncu potrebuje — brez segati po vtičnikih.",
		features: [
			{ title: "Vgrajen i18n", desc: "Usmerjanje in prevodi po jezikih z medjezikovnim nadomeščanjem. Objavi en- in sl- poti iz enega vira.", caption: "posnetek — jezikovno usmerjanje" },
			{ title: "Markdown vsebina", desc: "Piši objave in strani v markdownu s front-matter. Barvanje kode in oblikovanje besedila sta privzeta.", caption: "posnetek — markdown objava" },
			{ title: "RSS in sitemapi", desc: "Viri in sitemapi, ustvarjeni ob gradnji in pravilno lokalizirani, da ostaneta iskanje in bralniki usklajeni.", caption: "posnetek — ustvarjen sitemap" },
			{ title: ".ree komponente", desc: "Sestavljaj strani iz majhnih, večkrat uporabnih komponent — isti minimalen, znan pogon povsod.", caption: "posnetek — knjižnica komponent" },
		],

		how_h: "Pripravljeno v nekaj minutah",
		how_intro: "Namesti, zaženi razvojni strežnik, zgradi. To je celotna zanka.",
		steps: [
			{ n: "01", title: "Namesti", desc: "Dodaj Reeweb v projekt — ena drobna odvisnost, Bun-native." },
			{ n: "02", title: "Ustvarjaj", desc: "Piši .ree predloge in markdown. Sproten ponovni nalog med delom." },
			{ n: "03", title: "Zgradi in objavi", desc: "Ustvari statični paket in ga objavi na poljubnem CDN ali statičnem gostovanju." },
		],
		code: "bun install\nbun run dev\nbun run build",

		built_h: "Zgrajeno z Reeweb",
		built_intro: "Nekaj strani in projektov, ki tečejo na njem. Naslednja je lahko tvoja.",
		built_with: [
			{ caption: "posnetek — predstavitvena stran" },
			{ caption: "posnetek — dokumentacija" },
			{ caption: "posnetek — blog" },
			{ caption: "posnetek — pristajalna stran" },
			{ caption: "posnetek — portfelj" },
			{ caption: "posnetek — stran dogodka" },
		],

		quote: "Težko ogrodje smo zamenjali z Reeweb in gradnja se je z minut skrajšala na sekunde. Preprosto je manj stvari, ki gredo lahko narobe.",
		quote_by: "Placeholder izjava — vodja razvoja",

		ladder_h: "Statično postaja premajhno?",
		ladder: "Ko projekt potrebuje bazo, avtentikacijo ali zaledje, se povzpni na ogrodje Reepolee — isti pogon, iste konvencije, več moči.",
		ladder_cta: "Poglej ogrodje",

		cta_h: "Želite pomoč pri uvedbi?",
		cta: "Pomagamo vam sprejeti Reeweb kot osnovo vaše ekipe za statične strani in iz njega iztržiti kar največ.",
		results_cta: "Poglej rezultate",
		talk_cta: "Kontaktiraj Reepolee",
	},
}[lang];
props.c = c;
props.page_title = c.title;
props.light_hero = true;
props.hero = {
	kicker: c.kicker,
	title: c.h1,
	subtitle: c.promise,
	image: "/images/responsive/hero-privacy.png",
	image_alt: "",
	ctas: [
		{ href: "/reeweb/docs", label: c.docs, primary: true },
		{ href: "https://github.com/reepolee", label: c.github },
	],
};
}}

<main>
	<page-hero></page-hero>

	<!-- ── Social proof strip ── -->
	<div class="bg-warm py-16">
		<div class="container mx-auto">
			<div class="flex items-center gap-x-4 text-sm font-semibold tracking-[0.2em] text-brand uppercase">
				<span class="h-px w-10 bg-brand"></span>
				<span>{= c.proof_kicker }</span>
			</div>
			<md-text type="text" class="mt-6 max-w-3xl font-normal">{~ props.c.proof_line }</md-text>
			<div class="mt-10 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
				{#each c.proof_logos as logo}
					<media-frame label="{= logo.caption }" ratio="3/1"></media-frame>
				{/each}
			</div>
		</div>
	</div>

	<!-- ── Why ── -->
	<div class="py-g container mx-auto">
		<md-text type="h1" as="h2">{~ props.c.why_h }</md-text>
		<md-text type="text" class="mt-6 max-w-3xl font-normal">{~ props.c.why_intro }</md-text>
		<div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-3">
			{#each c.why as item}
				<div class="flex flex-col gap-5">
					<media-frame label="{= item.caption }" ratio="4/3"></media-frame>
					<div class="text-xl font-semibold">{= item.title }</div>
					<div class="text-muted leading-relaxed">{= item.desc }</div>
				</div>
			{/each}
		</div>
	</div>

	<!-- ── Feature showcase (alternating imagery rows) ── -->
	<div class="bg-warm py-g">
		<div class="container mx-auto">
			<md-text type="h1" as="h2">{~ props.c.features_h }</md-text>
			<md-text type="text" class="mt-6 max-w-3xl font-normal">{~ props.c.features_intro }</md-text>
			<div class="mt-16 flex flex-col gap-16 lg:gap-24">
				{#each c.features as f, i}
					<div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16{~ i % 2 === 1 ? ' lg:[&>*:first-child]:order-2' : '' }">
						<media-frame label="{= f.caption }" ratio="16/9"></media-frame>
						<div class="flex flex-col gap-4">
							<div class="text-2xl font-semibold lg:text-3xl">{= f.title }</div>
							<div class="text-muted text-lg leading-relaxed">{= f.desc }</div>
						</div>
					</div>
				{/each}
			</div>
		</div>
	</div>

	<!-- ── How it works ── -->
	<div class="py-g container mx-auto">
		<md-text type="h1" as="h2">{~ props.c.how_h }</md-text>
		<md-text type="text" class="mt-6 max-w-3xl font-normal">{~ props.c.how_intro }</md-text>
		<div class="mt-16 grid grid-cols-1 gap-8 md:grid-cols-3">
			{#each c.steps as step}
				<div class="border-divider flex flex-col gap-3 border-t pt-6">
					<div class="text-brand text-4xl font-semibold">{= step.n }</div>
					<div class="text-xl font-semibold">{= step.title }</div>
					<div class="text-muted leading-relaxed">{= step.desc }</div>
				</div>
			{/each}
		</div>
		<pre class="bg-code-bg text-paper mt-12 overflow-x-auto rounded-lg p-6 text-sm leading-7"><code>{= c.code }</code></pre>
	</div>

	<!-- ── Built with Reeweb ── -->
	<div class="bg-warm py-g">
		<div class="container mx-auto">
			<md-text type="h1" as="h2">{~ props.c.built_h }</md-text>
			<md-text type="text" class="mt-6 max-w-3xl font-normal">{~ props.c.built_intro }</md-text>
			<div class="mt-16 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
				{#each c.built_with as site}
					<media-frame label="{= site.caption }" ratio="16/10"></media-frame>
				{/each}
			</div>
		</div>
	</div>

	<!-- ── Quote ── -->
	<div class="py-g container mx-auto max-w-4xl text-center">
		<div class="prose mx-auto text-balance text-2xl font-semibold leading-snug lg:text-4xl">“{= c.quote }”</div>
		<div class="text-muted mt-8 font-semibold">{= c.quote_by }</div>
	</div>

	<!-- ── Upgrade ladder + Final CTA ── -->
	<div class="py-g container mx-auto max-w-4xl">
		<div class="border-divider border-t pt-16">
			<md-text type="h3" as="h2" class="normal-case">{~ props.c.ladder_h }</md-text>
			<md-text type="text" class="mt-6">{~ props.c.ladder }</md-text>
			<div class="mt-8">
				<link-button href="/reepolee">{~ props.c.ladder_cta }</link-button>
			</div>
		</div>

		<div class="border-divider mt-16 border-t pt-8">
			<md-text type="h3" as="h2" class="normal-case">{~ props.c.cta_h }</md-text>
			<md-text type="text" class="mt-6">{~ props.c.cta }</md-text>
			<div class="mt-8 flex flex-col gap-6 sm:flex-row">
				<link-button href="/results">{~ props.c.results_cta }</link-button>
				<link-button href="/contact" class="primary">{~ props.c.talk_cta }</link-button>
			</div>
		</div>
	</div>
</main>
