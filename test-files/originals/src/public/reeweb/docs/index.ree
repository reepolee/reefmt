{#layout("reeweb/docs/docs.layout")}

{#if lang === 'sl'}
<div class="mb-12 rounded-xl border border-divider bg-warm p-5">
	<p class="text-muted">Dokumentacija za Reeweb je na voljo samo v angleščini.</p>
</div>
{/if}

<!-- Introduction -->
<section id="introduction" data-intersect="introduction" class="scroll-mt-30 fade-in">
	<div class="flex items-center gap-3 mb-2">
		<span class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-badge bg-badge-light rounded-full px-3 py-1">
			<span class="w-1.5 h-1.5 rounded-full bg-badge"></span>
			Zero Dependencies
		</span>
		<span class="text-xs text-muted font-mono">"dependencies": {}</span>
	</div>
	<h1 class="font-display text-5xl lg:text-6xl italic leading-[1.05] mb-6">
		Zero ceremony. <br/>
		<span class="text-accent">Ship content sites fast.</span>
	</h1>
	<p class="text-lg leading-relaxed text-muted max-w-2xl mb-8">
		Reeweb is a template for Bun-powered static sites with zero runtime dependencies. Powered by the Ree templating language and Tailwind CSS, it handles the entire build pipeline so you can focus on content.
	</p>

	<!-- Feature cards -->
	<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-16">
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="mb-3"><img src="/bun.svg" class="w-8 h-8" alt="Bun" /></div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Bun-Powered</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">Fast builds and live reload in development — no webpack, no vite, just Bun.</p>
		</div>
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="mb-3"><span class="font-mono text-2xl font-bold">.ree</span></div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Ree Templates</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">Expressive .ree templating with layouts, partials, loops, and components alongside Markdown.</p>
		</div>
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="mb-3"><span class="font-mono text-2xl font-bold">i18n</span></div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Multi-Language</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">First-class internationalisation with per-language routing and fallback translation chains.</p>
		</div>
	</div>
</section>

<hr class="border-divider mb-12" />

<!-- Preparation -->
<section id="preparation" data-intersect="preparation" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Preparation</h2>
	<p class="text-muted leading-relaxed mb-6">Install the prerequisites globally so they can be reused across projects. <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">conc</code> is used until <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">bun --parallel</code> is production ready.</p>

	<div class="bg-warm rounded-xl p-6 space-y-4 mb-6">
		<div class="flex items-start gap-4">
			<span class="shrink-0 w-8 h-8 flex items-center justify-center"><img src="/bun.svg" class="size-5" alt="Bun" /></span>
			<div>
				<p class="font-semibold mb-1">Bun</p>
				<p class="text-muted leading-relaxed">Install from <a href="https://bun.com/docs/installation" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">bun.com</a> — the JavaScript runtime that powers Reeweb.</p>
			</div>
		</div>
		<div class="flex items-start gap-4">
			<span class="shrink-0 w-8 h-8 flex items-center justify-center"><img src="/tailwindcss.svg" class="size-5" alt="Tailwind CSS" /></span>
			<div>
				<p class="font-semibold mb-1">Tailwind CSS</p>
				<p class="text-muted leading-relaxed">Install via <code class="font-mono text-xs bg-paper px-1.5 py-0.5 rounded">bun add -g @tailwindcss/cli</code> or from <a href="https://github.com/tailwindlabs/tailwindcss/releases" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">GitHub releases</a>.</p>
			</div>
		</div>
		<div class="flex items-start gap-4">
			<span class="shrink-0 w-8 h-8 flex items-center justify-center">⚙️</span>
			<div>
				<p class="font-semibold mb-1">Concurrently</p>
				<p class="text-muted leading-relaxed">Install via <code class="font-mono text-xs bg-paper px-1.5 py-0.5 rounded">bun add -g concurrently</code> — used until <code class="font-mono text-xs bg-paper px-1.5 py-0.5 rounded">bun --parallel</code> is production ready.</p>
			</div>
		</div>
		<div class="flex items-start gap-4">
			<span class="shrink-0 w-8 h-8 flex items-center justify-center"><span class="font-mono text-xs font-bold text-muted">fmt</span></span>
			<div>
				<p class="font-semibold mb-1">oxfmt</p>
				<p class="text-muted leading-relaxed">Install via <code class="font-mono text-xs bg-paper px-1.5 py-0.5 rounded">bun add -g oxfmt</code> — formatter for JS/TS files.</p>
			</div>
		</div>
		<div class="flex items-start gap-4">
			<span class="shrink-0 w-8 h-8 flex items-center justify-center"><span class="font-mono text-xs font-bold text-muted">lint</span></span>
			<div>
				<p class="font-semibold mb-1">oxlint</p>
				<p class="text-muted leading-relaxed">Install via <code class="font-mono text-xs bg-paper px-1.5 py-0.5 rounded">bun add -g oxlint</code> — fast JavaScript linter.</p>
			</div>
		</div>
	</div>

	<p class="text-muted leading-relaxed mb-4">Verify your installation — you should get version output for each:</p>
	<div class="code-block relative rounded-xl overflow-hidden bg-code-bg border border-white/5">
		<pre class="p-5 overflow-x-auto"><code class="hljs language-bash text-sm leading-relaxed">bun -v
tailwindcss -h | grep v
conc -v
oxfmt --version
oxlint --version</code></pre>
	</div>
</section>

<hr class="border-divider mb-12" />

<!-- Get Started -->
<section id="development" data-intersect="development" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Get Started</h2>
	<p class="text-muted leading-relaxed mb-6">
		Create your project from the Reeweb template repository, wire <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">reepolee/reeweb</code> back in as upstream so future Reeweb releases stay one pull away, install, and run.
	</p>

	<div class="space-y-8 mb-8">
		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">1</span>
				<p class="font-semibold">Create your repo from the template</p>
			</div>
			<p class="text-muted leading-relaxed mb-3">Reeweb is a GitHub <em>template repository</em>. Click <strong>Use this template → Create a new repository</strong> on <a href="https://github.com/reepolee/reeweb" target="_blank" rel="noopener noreferrer" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">github.com/reepolee/reeweb</a> to spin up your own repo with clean history, then clone it locally:</p>
			<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4">
				<code class="font-mono text-sm" style="color:#e2e0d8">git clone git@github.com:&lt;your-account&gt;/my-site.git &amp;&amp; cd my-site</code>
				<button type="button" data-copy="git clone git@github.com:<your-account>/my-site.git && cd my-site" class="shrink-0 ml-auto cursor-pointer" title="Copy">
					<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
				</button>
			</div>
			<p class="text-xs text-muted mt-2">Prefer to do the same thing by hand without GitHub's UI? <a href="/reeweb/docs/getting-started/quick-start#without-the-github-ui" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">Quick Start walks through the manual flow</a>.</p>
		</div>

		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">2</span>
				<p class="font-semibold">Wire Reeweb back in as upstream</p>
			</div>
			<p class="text-muted leading-relaxed mb-3">Your repo's <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">origin</code> points to your account — it knows nothing about Reeweb. Add <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">reepolee/reeweb</code> as <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">upstream</code> so you can pull future Reeweb releases into your project:</p>
			<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4">
				<code class="font-mono text-sm" style="color:#e2e0d8">git remote add upstream https://github.com/reepolee/reeweb.git</code>
				<button type="button" data-copy="git remote add upstream https://github.com/reepolee/reeweb.git" class="shrink-0 ml-auto cursor-pointer" title="Copy">
					<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
				</button>
			</div>
		</div>

		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">3</span>
				<p class="font-semibold">Install dev dependencies</p>
			</div>
			<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4">
				<code class="font-mono text-sm" style="color:#e2e0d8">bun install</code>
				<button type="button" data-copy="bun install" class="shrink-0 ml-auto cursor-pointer" title="Copy">
					<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
				</button>
			</div>
		</div>

		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">4</span>
				<p class="font-semibold">Copy the environment file</p>
			</div>
			<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4">
				<code class="font-mono text-sm" style="color:#e2e0d8">cp .env.example .env</code>
				<button type="button" data-copy="cp .env.example .env" class="shrink-0 ml-auto cursor-pointer" title="Copy">
					<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
				</button>
			</div>
		</div>

		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">5</span>
				<p class="font-semibold">Run in development</p>
			</div>
			<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4">
				<code class="font-mono text-sm" style="color:#e2e0d8">bun dev</code>
				<button type="button" data-copy="bun dev" class="shrink-0 ml-auto cursor-pointer" title="Copy">
					<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
				</button>
			</div>
		</div>

		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">6</span>
				<p class="font-semibold">Build for production</p>
			</div>
			<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4">
				<code class="font-mono text-sm" style="color:#e2e0d8">bun run build</code>
				<button type="button" data-copy="bun run build" class="shrink-0 ml-auto cursor-pointer" title="Copy">
					<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
				</button>
			</div>
		</div>
	</div>

	<div class="flex gap-3 bg-accent-dim border border-accent/15 rounded-xl p-5">
		<span class="text-accent text-lg leading-none mt-0.5">→</span>
		<div>
			<p class="text-sm font-semibold text-ink mb-1">No runtime dependencies</p>
			<p class="text-sm text-muted leading-relaxed">Really, <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded">"dependencies": {}</code>. Reeweb only has dev dependencies — Tailwind CSS and Bun type definitions. Everything runs on Bun's built-in APIs. Upgrades are a git operation: <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded">git pull upstream main</code>.</p>
		</div>
	</div>
</section>

<hr class="border-divider mb-12" />

<!-- Build Pipeline -->
<section id="build-pipeline" data-intersect="build-pipeline" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Build Pipeline</h2>
	<p class="text-muted leading-relaxed mb-6">Write content as <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">.ree</code> or <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">.md</code> files in <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">src/public/</code>. The build pipeline compiles them into a static <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">dist/</code> folder ready to deploy anywhere.</p>

	<div class="space-y-8 mb-8">
		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">1</span>
				<p class="font-semibold">Write a page</p>
			</div>
			<p class="text-muted leading-relaxed mb-3">Drop a <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">.ree</code> or <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">.md</code> file in <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">src/public/</code>. The path determines the URL — <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">src/public/about/index.ree</code> becomes <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">/about/</code>.</p>
		</div>
		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">2</span>
				<p class="font-semibold">Attach data via a sibling .ts file</p>
			</div>
			<p class="text-muted leading-relaxed mb-3">Export a <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">load_template_data</code> function alongside the template to pass data into <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">props</code> at build time:</p>
			<div class="copy-row flex items-center rounded-xl bg-code-bg border border-white/5 px-5 py-4">
				<code class="font-mono text-sm" style="color:#e2e0d8">export async function load_template_data({ lang }) { return { posts } }</code>
				<button type="button" data-copy="export async function load_template_data({ lang }) { return { posts } }" class="shrink-0 ml-auto cursor-pointer" title="Copy">
					<svg class="copy-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
					<svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#4ade80" stroke-width="2"><path d="M20 6 9 17l-5-5"/></svg>
				</button>
			</div>
		</div>
		<div>
			<div class="flex items-center gap-3 mb-3">
				<span class="shrink-0 w-8 h-8 rounded-md bg-accent text-white flex items-center justify-center text-sm font-mono font-bold">3</span>
				<p class="font-semibold">Build, then preview and deploy</p>
			</div>
			<p class="text-muted leading-relaxed">Build outputs to <code class="font-mono text-xs bg-paper px-1.5 py-0.5 rounded">dist/</code>. Optionally generate a sitemap and RSS feeds, then preview the output locally before deploying:</p>
		</div>
	</div>

	<div class="code-block relative rounded-xl overflow-hidden bg-code-bg border border-white/5 mb-6">
		<pre class="px-5 py-5"><code class="hljs language-bash text-sm leading-relaxed">bun run build           # compile src/public/ → dist/
bun run sitemap         # generate dist/sitemap.xml + robots.txt
bun run rss             # generate dist/feed.xml + feed.json
bun run preview         # serve dist/ locally to verify before deploy</code></pre>
	</div>

	<p class="text-muted leading-relaxed mb-4">Add a frontmatter block to any <code class="font-mono text-xs bg-warm px-1.5 py-0.5 rounded border border-divider">.md</code> file to control layout, metadata, and sitemap behavior:</p>
	<div class="code-block relative rounded-xl overflow-hidden bg-code-bg border border-white/5">
		<pre class="p-5"><code class="hljs language-yaml text-sm leading-relaxed">---
layout: blog/layout
title: My Post
published_at: 2025-06-01
author: Jane Doe
---</code></pre>
	</div>
</section>

<hr class="border-divider mb-12" />

<!-- Ecosystem -->
<section id="ecosystem" data-intersect="ecosystem" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Explore the ecosystem</h2>
	<p class="text-muted leading-relaxed mb-6">
		Reepolee is a small family of tools that work together. Explore the others — each has its own documentation.
	</p>

	<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
		<a href="/reepolee/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reepolee</p>
				<p class="text-xs text-muted">Full-stack framework</p>
			</div>
		</a>
		<a href="/reefmt/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reefmt</p>
				<p class="text-xs text-muted">Ree template formatter</p>
			</div>
		</a>
		<a href="/sqlfmt/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">SQLfmt</p>
				<p class="text-xs text-muted">SQL formatter</p>
			</div>
		</a>
		<a href="/ree-templates-vscode/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
