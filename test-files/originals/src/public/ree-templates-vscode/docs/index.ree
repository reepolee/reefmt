{#layout("ree-templates-vscode/docs/docs.layout")}

{#if lang === 'sl'}
<div class="mb-12 rounded-xl border border-divider bg-warm p-5">
	<p class="text-muted">Dokumentacija za razširitev Ree Templates je na voljo samo v angleščini.</p>
</div>
{/if}

<!-- Introduction -->
<section id="introduction" data-intersect="introduction" class="scroll-mt-30 fade-in">
	<div class="flex items-center gap-3 mb-2">
		<span class="inline-flex items-center gap-1.5 text-xs font-mono font-medium text-badge bg-badge-light rounded-full px-3 py-1">
			<span class="w-1.5 h-1.5 rounded-full bg-badge"></span>
			Reepolee tooling
		</span>
		<span class="text-xs text-muted font-mono">VS Code extension · publisher: reepolee</span>
	</div>
	<h1 class="font-display text-5xl lg:text-6xl italic leading-[1.05] mb-6">
		Ree Templates,<br/>
		<span class="text-accent">first-class in your editor.</span>
	</h1>
	<p class="text-lg leading-relaxed text-muted max-w-2xl mb-8">
		The Ree Templates extension brings syntax highlighting, formatting, and branded file icons to <code class="font-mono text-sm bg-warm px-1.5 py-0.5 rounded border border-divider">.ree</code> files in Visual Studio Code. Formatting is powered by Reefmt, so your editor and your command line agree.
	</p>

	<!-- Feature cards -->
	<div class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-16">
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="text-2xl mb-3">🎨</div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Syntax highlighting</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">A TextMate grammar for the Ree language: HTML, embedded JavaScript and CSS, and every Ree directive and expression.</p>
		</div>
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="mb-3"><span class="font-mono text-2xl font-bold">fmt</span></div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Formatting</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">Format Document and format-on-save for <code class="font-mono text-xs">.ree</code> files, backed by the Reefmt binary.</p>
		</div>
		<div class="group bg-warm rounded-xl p-5 hover:bg-ink hover:text-paper transition-all duration-300 cursor-default">
			<div class="mb-3"><img src="/ree-file.svg" alt=".ree file icon" class="w-8 h-8" /></div>
			<h3 class="font-bold text-sm mb-1 group-hover:text-paper">Branded icons</h3>
			<p class="text-xs text-muted group-hover:text-paper/60 leading-relaxed">A bundled icon theme plus optional vscode-icons integration for the red "R" file and folder icons.</p>
		</div>
	</div>
</section>

<hr class="border-divider mb-12" />

<!-- Quick start -->
<section id="quick-start" data-intersect="quick-start" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Quick start</h2>
	<p class="text-muted leading-relaxed mb-6">
		Install the extension from the Marketplace, install Reefmt for formatting, and open any <code class="font-mono text-sm bg-warm px-1.5 py-0.5 rounded border border-divider">.ree</code> file.
	</p>

	<a href="https://marketplace.visualstudio.com/items?itemName=reepolee.ree-templates" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-warm rounded-xl px-6 py-4 hover:ring-2 hover:ring-accent/20 transition-all group mb-6">
		<div class="w-10 h-10 flex items-center justify-center">
			<img src="/ree-file.svg" alt=".ree file" class="w-8 h-8" />
		</div>
		<div>
			<p class="text-sm font-semibold group-hover:text-accent transition-colors">Ree Templates on the Marketplace</p>
			<p class="text-xs text-muted">Syntax highlighter &amp; formatter</p>
		</div>
		<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="ml-4 text-muted group-hover:text-accent group-hover:translate-x-1 transition-all"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
	</a>

	<p class="text-muted leading-relaxed">
		See <a href="/ree-templates-vscode/docs/getting-started/installation" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">Installation</a> to get set up, then <a href="/ree-templates-vscode/docs/configuration/settings" class="text-accent underline underline-offset-2 decoration-accent/40 hover:decoration-accent transition-colors">Configuration</a> for the available settings.
	</p>
</section>

<hr class="border-divider mb-12" />

<!-- Ecosystem -->
<section id="ecosystem" data-intersect="ecosystem" class="scroll-mt-30 fade-in mb-16">
	<h2 class="font-display text-3xl italic mb-6">Explore the ecosystem</h2>
	<p class="text-muted leading-relaxed mb-6">
		Reepolee is a small family of tools that work together. Explore the others — each has its own documentation.
	</p>

	<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
		<a href="/reepolee/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reepolee</p>
				<p class="text-xs text-muted">Full-stack framework</p>
			</div>
		</a>
		<a href="/reeweb/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reeweb</p>
				<p class="text-xs text-muted">Static site generator</p>
			</div>
		</a>
		<a href="/reefmt/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reefmt</p>
				<p class="text-xs text-muted">Ree template formatter</p>
			</div>
		</a>
		<a href="/sqlfmt/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">SQLfmt</p>
				<p class="text-xs text-muted">SQL formatter</p>
			</div>
		</a>
		<a href="/reemerge/docs" target="_blank" rel="noopener noreferrer" class="group flex items-center gap-3 bg-warm rounded-xl px-5 py-4 hover:ring-2 hover:ring-accent/20 transition-all">
			<img src="/ree-file.svg" alt="" class="w-8 h-8 shrink-0" />
			<div class="min-w-0">
				<p class="text-sm font-semibold group-hover:text-accent transition-colors">Reemerge</p>
				<p class="text-xs text-muted">Interactive cherry-pick for PRs</p>
			</div>
		</a>
	</div>
</section>
