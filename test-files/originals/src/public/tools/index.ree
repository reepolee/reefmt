{#layout("layout")}
{{
const c = {
	en: {
		title: "Tools | Reepolee",
		kicker: "Open source",
		h1: "Two products,<br>**one engine**",
		intro: "Zero dependencies. Bun-native today. Radically simple. We ship the way we work — as open source.",
		ladder: "Start with **Reeweb** for static sites. When a project needs a database, auth or a backoffice, there's a clean upgrade path to the **Reepolee framework** — same engine, same conventions, more power.",
		engine_line: "Both run on Ree, our own templating engine — the shared glue, documented but not sold separately.",
		by: "Both by Reepolee.",
		reeweb_name: "Reeweb",
		reeweb_badge: "Static",
		reeweb_tagline: "Static sites with .ree templates, i18n, markdown, RSS and sitemaps. The easy first rung.",
		reeweb_cta: "Explore Reeweb",
		reeweb_caption: "screenshot — Reeweb site",
		fw_name: "Reepolee framework",
		fw_badge: "Full-stack",
		fw_tagline: "Your development baseline: SSR, CRUD & schema generators, auth and modules — fully owned, zero lock-in.",
		fw_cta: "Explore the framework",
		fw_caption: "screenshot — framework app",
			more_tools_h: "The rest of the toolbox",
			more_tools_intro: "Small, sharp tools that support the two products and keep the workflow consistent — each with its own documentation.",
			more_tools: [
				{ name: "Reefmt", badge: "CLI", desc: "Fast, dependency-free formatter for .ree templates. A single Rust binary.", href: "/reefmt/docs" },
				{ name: "SQLfmt", badge: "CLI", desc: "Deterministic SQL formatter. Rust, fast, zero configuration.", href: "/sqlfmt/docs" },
				{ name: "Reemerge", badge: "CLI", desc: "Interactive cherry-pick for preparing clean, hand-picked pull requests. A single Rust binary.", href: "/reemerge/docs" },
				{ name: "Ree Templates for VSCode", badge: "Editor", desc: "Syntax highlighting, icons and format-on-save for .ree files.", href: "/ree-templates-vscode/docs" },
			],
	},
	sl: {
		title: "Orodja | Reepolee",
		kicker: "Odprta koda",
		h1: "Dva izdelka,<br>**en pogon**",
		intro: "Brez odvisnosti. Danes Bun-native. Radikalno preprosto. Objavljamo, kakor delamo — kot odprto kodo.",
		ladder: "Začnite z **Reeweb** za statične strani. Ko projekt potrebuje bazo, avtentikacijo ali zaledje, obstaja čista pot nadgradnje do **ogrodja Reepolee** — isti pogon, iste konvencije, več moči.",
		engine_line: "Oba poganja Ree, naš lastni pogon za predloge — skupno lepilo, dokumentirano, a ne prodajano ločeno.",
		by: "Oba ustvarja Reepolee.",
		reeweb_name: "Reeweb",
		reeweb_badge: "Statično",
		reeweb_tagline: "Statične strani z .ree predlogami, i18n, markdownom, RSS in sitemapi. Enostavna prva stopnička.",
		reeweb_cta: "Razišči Reeweb",
		reeweb_caption: "posnetek — stran Reeweb",
		fw_name: "Ogrodje Reepolee",
		fw_badge: "Full-stack",
		fw_tagline: "Vaša razvojna osnova: SSR, CRUD in generatorji shem, avtentikacija in moduli — v vaši lasti, brez vezave.",
		fw_cta: "Razišči ogrodje",
		fw_caption: "posnetek — aplikacija na ogrodju",
			more_tools_h: "Preostala orodja",
			more_tools_intro: "Majhna, ostra orodja, ki podpirajo oba izdelka in ohranjajo dosleden potek dela — vsako s svojo dokumentacijo.",
			more_tools: [
				{ name: "Reefmt", badge: "CLI", desc: "Hiter formater za .ree predloge brez odvisnosti. Ena sama izvedljiva datoteka v Rustu.", href: "/reefmt/docs" },
				{ name: "SQLfmt", badge: "CLI", desc: "Determinističen formater za SQL. Rust, hiter, brez nastavitev.", href: "/sqlfmt/docs" },
				{ name: "Reemerge", badge: "CLI", desc: "Interaktivni cherry-pick za pripravo čistih, ročno izbranih pull requestov. Ena sama izvedljiva datoteka v Rustu.", href: "/reemerge/docs" },
				{ name: "Ree Templates za VSCode", badge: "Urejevalnik", desc: "Barvanje sintakse, ikone in oblikovanje ob shranjevanju za .ree datoteke.", href: "/ree-templates-vscode/docs" },
			],
	},
}[lang];
props.c = c;
props.page_title = c.title;
props.light_hero = true;
props.hero = { kicker: c.kicker, title: c.h1, subtitle: c.intro, image: "/images/responsive/hero-privacy.png", image_alt: "" };
}}

<main>
	<page-hero></page-hero>

	<div class="py-g container mx-auto">
		<div class="flex flex-col gap-8 lg:flex-row lg:items-stretch">
			<a href="{~ localized_path('/reeweb') }" class="group flex flex-1 flex-col gap-y-4 border-t border-divider p-8 transition-all hover:bg-black/5">
				<media-frame label="{= c.reeweb_caption }" ratio="16/9"></media-frame>
				<div class="flex items-center justify-between">
					<div class="text-2xl font-semibold lg:text-3xl">{= c.reeweb_name }</div>
					<span class="rounded-full border border-divider px-3 py-1 text-sm font-semibold">{= c.reeweb_badge }</span>
				</div>
				<div class="prose text-base font-normal text-balance lg:text-lg">{~ md(c.reeweb_tagline) }</div>
				<div class="mt-2 inline-flex items-center gap-x-3 font-semibold text-brand">
					<span>{= c.reeweb_cta }</span>
					<re-arrow direction="right" class="h-6 w-6"></re-arrow>
				</div>
			</a>
			<div class="flex items-center justify-center">
				<re-arrow direction="right" class="h-10 w-10 rotate-90 lg:rotate-0"></re-arrow>
			</div>
			<a href="{~ localized_path('/reepolee') }" class="group flex flex-1 flex-col gap-y-4 border-t border-divider p-8 transition-all hover:bg-black/5">
				<media-frame label="{= c.fw_caption }" ratio="16/9"></media-frame>
				<div class="flex items-center justify-between">
					<div class="text-2xl font-semibold lg:text-3xl">{= c.fw_name }</div>
					<span class="rounded-full border border-divider px-3 py-1 text-sm font-semibold">{= c.fw_badge }</span>
				</div>
				<div class="prose text-base font-normal text-balance lg:text-lg">{~ md(c.fw_tagline) }</div>
				<div class="mt-2 inline-flex items-center gap-x-3 font-semibold text-brand">
					<span>{= c.fw_cta }</span>
					<re-arrow direction="right" class="h-6 w-6"></re-arrow>
				</div>
			</a>
		</div>

		<md-text type="text" class="mt-16 max-w-3xl">{~ props.c.ladder }</md-text>
		<md-text type="text-sm" class="mt-8 max-w-3xl italic">{~ props.c.engine_line }</md-text>
		<div class="text-muted mt-8 font-semibold">{= c.by }</div>

		<!-- The rest of the toolbox — lower significance, mirrors the docs-index ecosystem cards -->
		<div class="border-divider mt-24 border-t pt-16">
			<md-text type="h3" as="h2" class="normal-case">{~ props.c.more_tools_h }</md-text>
			<md-text type="text" class="mt-6 max-w-3xl font-normal">{~ props.c.more_tools_intro }</md-text>

			<div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-3">
				{#each c.more_tools as tool}
					<a href="{~ localized_path(tool.href) }" class="group bg-warm flex flex-col gap-3 rounded-xl p-6 transition-all hover:ring-2 hover:ring-brand/20">
						<div class="flex items-center justify-between">
							<img src="/ree-file.svg" alt="" class="h-8 w-8 shrink-0" />
							<span class="border-divider text-muted rounded-full border px-2.5 py-0.5 text-xs font-semibold">{= tool.badge }</span>
						</div>
						<div class="group-hover:text-brand mt-1 text-lg font-semibold transition-colors">{= tool.name }</div>
						<div class="text-muted text-sm leading-relaxed">{= tool.desc }</div>
						<div class="text-brand mt-2 inline-flex items-center gap-x-2 text-sm font-semibold">
							<span>{= lang === 'sl' ? 'Dokumentacija' : 'Read the docs' }</span>
							<re-arrow direction="right" class="h-4 w-4"></re-arrow>
						</div>
					</a>
				{/each}
			</div>
		</div>
	</div>
</main>
