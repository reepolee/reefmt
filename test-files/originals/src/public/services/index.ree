{#layout("layout")}
{{
const c = {
	en: {
		title: "Services | Reepolee",
		kicker: "What we do",
		h1: "We make<br>ourselves **optional**",
		subtitle:
			"Most consultancies are built to be kept. Every engagement we take is built to leave your team **self-sufficient** — running on Reepolee, and done needing us.",
		pillar_h: "How we **do it**",
		pillar:
			"Every engagement comes down to the same idea: **adopt the Reepolee framework as your development baseline** — and we help you get the most out of it. The baseline is *yours*, so your team ends up self-sufficient, never dependent on us.",
		lets_talk: "Let's talk",
		results_cta: "See the results",
	},
	sl: {
		title: "Storitve | Reepolee",
		kicker: "Kaj počnemo",
		h1: "Postanemo<br>**odveč**",
		subtitle:
			"Večina svetovalcev se gradi tako, da jih obdržite. Vsako sodelovanje, ki ga prevzamemo, je zasnovano tako, da postane vaša ekipa **samozadostna** — na Reepoleeju in brez potrebe po nas.",
		pillar_h: "Kako to **počnemo**",
		pillar:
			"Vsako sodelovanje se zvede na isto idejo: **sprejmite ogrodje Reepolee kot svojo razvojno osnovo** — mi pa vam pomagamo, da iz nje iztržite kar največ. Osnova je *vaša*, zato postane vaša ekipa samozadostna in nikoli odvisna od nas.",
		lets_talk: "Kontakt",
		results_cta: "Poglej rezultate",
	},
}[lang];
props.c = c;
props.page_title = c.title;
props.light_hero = true;
props.hero = {
	kicker: c.kicker,
	title: c.h1,
	subtitle: c.subtitle,
	image: "/images/responsive/hero-my-services.png",
	image_alt: "",
	ctas: [
		{ href: "/contact", label: c.lets_talk, primary: true },
		{ href: "/results", label: c.results_cta },
	],
};
}}

<main>
	<page-hero></page-hero>

	<!-- The pillar: "how we do it" copy + CTA frames the numbered service list,
	     mirroring the homepage Services layout. Warm surface so it reads as its
	     own section rather than blending into the white hero. -->
	<div class="bg-warm">
		<div class="py-g container mx-auto">
			<md-text type="h1" as="h2">{~ props.c.pillar_h }</md-text>
			<div class="mt-12 flex flex-col gap-y-24 md:mt-24 lg:flex-row lg:gap-x-16">
				<div class="left flex-1 text-xl leading-8">
					<md-text type="text" class="pb-10">{~ props.c.pillar }</md-text>
					<div class="flex flex-col gap-4 sm:flex-row">
						<link-button href="/contact" class="primary">{~ props.c.lets_talk }</link-button>
						<link-button href="/results" class="hover:bg-black/10">{~ props.c.results_cta }</link-button>
					</div>
				</div>
				<div class="right flex-2">
					{#each props.services[lang] as service, id}
						<service-item title="{= service.title }" content="{= service.content }" id="{= id }"></service-item>
					{/each}
				</div>
			</div>
		</div>
	</div>
</main>
