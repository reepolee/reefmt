{#layout("layout")}
{{
// Expose the localized copy on props so custom-element slots (which run in an
// isolated scope that only sees props + globals) can reference it directly.
props.t = props.home[lang];
const t = props.t;
const tw = props.tailwind_version;
// Homepage uses the light editorial hero, so the fixed nav sits on a light
// surface from the top — tell the layout to render it with ink (not white) text.
props.light_hero = true;
const edge_label = lang === "sl" ? "njihovega globalnega robnega omrežja" : "their global edge network";
// Build-time fallback above; on Cloudflare cf-edge.js swaps in the real colo via {city}.
const edge_template = lang === "sl" ? "podatkovnega centra {city}" : "{city} data center";
// Hero copy that isn't in the shared data file — short, easy to localize inline.
const hero_kicker = lang === "sl" ? "Programsko svetovanje · Odprto ogrodje" : "Software consultancy · Open framework";
const hero_photo_alt = lang === "sl" ? "Reepolee pri delu" : "Reepolee at work";
}}

<main>
	<!-- ── Hero (light editorial — ink + red on warm paper, asymmetric).
	     pt-* reserves the fixed-nav band so the image panel never sits under it. ── -->
	<div class="hero-bg min-h-above-fold flex items-center pt-28 pb-24 lg:pt-32">
		<div class="container mx-auto w-full">
			<div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
				<!-- Copy -->
				<div class="flex flex-col items-start">
					<div class="mb-6 flex items-center gap-x-4 text-sm font-semibold tracking-[0.2em] text-brand uppercase">
						<span class="h-px w-10 bg-brand"></span>
						<span>{= hero_kicker }</span>
					</div>
					<md-text type="h1" as="h1" class="max-w-[16ch] text-left">{~ props.t.hero_h1 }</md-text>
					<div class="mt-10 flex flex-col gap-4 sm:flex-row">
						<a href="{~ localized_path('/contact') }" class="primary flex w-fit items-center gap-x-4 rounded px-6 py-3 font-semibold shadow-sm transition-all hover:shadow">
							<span>{~ props.t.hero_contact_cta }</span>
							<re-arrow direction="right" class="h-8 w-8"></re-arrow>
						</a>
						<link-button href="/results">{~ props.t.hero_results_cta }</link-button>
					</div>
				</div>
				<!-- Duotone image panel with offset red frame. Shown on every viewport
				     (shorter on mobile); the fixed heights keep it clear of the nav.
				     The decorative offset frame is desktop-only to avoid overflow. -->
				<div class="relative">
					<div class="absolute -right-6 -bottom-6 hidden h-2/3 w-2/3 rounded-2xl border border-brand/40 lg:block"></div>
					<div class="relative h-64 overflow-hidden rounded-2xl border border-divider shadow-xl sm:h-80 lg:h-104 xl:h-120">
						<responsive-image src="/images/responsive/hero-home.png" alt="{= hero_photo_alt }" loading="eager" image_class="h-full w-full object-cover" sizes="(max-width: 1024px) 100vw, 640px"></responsive-image>
						<div class="absolute inset-0 bg-brand/15 mix-blend-multiply"></div>
					</div>
				</div>
			</div>
		</div>
		<div class="scroll-indicator absolute bottom-12 flex w-full justify-around self-end">
			<mouse-scroll-indicator></mouse-scroll-indicator>
		</div>
	</div>

	<!-- ── ReepoleeShort ── -->
	<div class="py-g container mx-auto flex w-full flex-row gap-x-7 lg:gap-x-16">
		<div class="mt-6 h-px w-11 bg-divider lg:w-40"></div>
		<div class="heading flex flex-1 flex-col gap-y-12 lg:max-w-[800px] lg:gap-y-16">
			<md-text type="h3" class="font-semibold normal-case">{~ props.t.short_h3 }</md-text>
			<md-text type="text">{~ props.t.short_text }</md-text>
		</div>
	</div>

	<!-- ── Results strip (decision-maker hook) ── -->
	<results-strip></results-strip>

	<!-- ── Tools teaser (developer hook) ── -->
	<tools-teaser></tools-teaser>

	<!-- ── Services ── -->
	<div class="py-g container mx-auto" style="content-visibility: auto; contain-intrinsic-size: auto 700px;">
		<md-text type="h1" as="h2">{~ props.t.services_h1 }</md-text>

		<div class="mt-12 flex flex-col gap-y-24 md:mt-24 lg:flex-row lg:gap-x-16">
			<div class="left flex-1 text-xl leading-8">
				<md-text type="text" class="pb-10">{~ props.t.services_1 }</md-text>
				<link-button href="/services" class="primary">{~ props.t.lets_talk }</link-button>
			</div>
			<div class="right flex-2">
				{#each props.services[lang] as service, id}
					<service-item title="{= service.title }" content="{= service.content }" id="{= id }"></service-item>
				{/each}
			</div>
		</div>
	</div>

	<!-- ── Ales (bridge between the two halves of the brand) ── -->
	<div class="bg-warm py-g" style="content-visibility: auto; contain-intrinsic-size: auto 700px;">
		<div class="container mx-auto">
			<md-text type="h1" as="h2" class="text-center">{~ props.t.ales_h1 }</md-text>

			<div class="text-ink mx-auto flex max-w-7xl flex-col-reverse gap-x-12 gap-y-5 pt-24 md:items-center lg:flex-row lg:gap-x-24">
				<div class="flex flex-col gap-y-5 pt-8">
					<md-text type="text-lg" class="font-semibold">{~ props.t.ales_lg }</md-text>
					<md-text type="text">{~ props.t.ales_2 }</md-text>
					<md-text type="text">{~ props.t.ales_3 }</md-text>
					<link-button href="/contact" class="primary mt-2">{~ props.t.lets_talk }</link-button>
				</div>

				<responsive-image src="/images/responsive/ales-4-5.jpg" alt="{= props.t.ales_alt }" class="h-full w-full" sizes="(max-width: 512px) 300px, 800px" image_class="w-[410px] aspect-[4/5] rounded-lg"></responsive-image>
			</div>
		</div>
	</div>

	<!-- ── Stack ── -->
	<div class="bg-warm" style="content-visibility: auto; contain-intrinsic-size: auto 200px;">
		<div class="py-g container mx-auto">
			<md-text type="h1" as="h2" class="layout-grid text-center">{~ props.t.stack_h1 }</md-text>
			<md-text type="text" class="mx-auto mt-16 max-w-6xl text-center">{~ props.t.stack_1 }</md-text>
		</div>
	</div>

	<div class="bg-warm" style="content-visibility: auto; contain-intrinsic-size: auto 1000px;">
		<div class="pb-g container mx-auto">
			<!-- Reepolee framework + Ree (our own engine), Bun as today's runtime -->
			<div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:flex-row lg:items-center lg:gap-24">
				<div class="blurred flex h-64 items-center justify-center px-8 align-middle lg:h-96">
					<div class="text-brand h-40 w-40 lg:h-56 lg:w-56">{#include('$components/svgs/reepolee-logo.svg')}</div>
				</div>
				<div class="text-ink place-center flex-2 self-center text-base font-semibold text-pretty lg:text-lg">
					<div class="h-12 w-24">{#include('$components/svgs/quotes.svg')}</div>
					<br />
					<div>{= t.stack_framework }</div>
					<div class="text-md pt-8 font-normal md:text-xl lg:pt-12">{= t.stack_bun_1 }</div>
					<div class="text-md pt-8 md:text-xl lg:pt-12">
						<a href="{~ localized_path('/tools') }" class="text-brand hover:underline inline-flex flex-row items-center gap-2 transition-all">
							<div class="text-brand size-7 lg:size-8">{#include('$components/svgs/arrow-right.svg')}</div>
							<span>{= t.tools_all }</span>
						</a>
					</div>
				</div>
			</div>

			<div class="pt-g grid grid-cols-1 gap-12 md:grid-cols-2 lg:flex-row lg:items-center lg:gap-24">
				<div class="blurred stack-bg-2 flex h-64 items-center justify-center px-8 align-middle lg:h-96">
					<img loading="lazy" src="/assets/stack/tailwind-light.svg" alt="Tailwind logo" class="h-full px-4 md:px-0 lg:w-48 xl:w-64" />
				</div>
				<div class="text-ink place-center flex-2 self-center text-base font-semibold text-pretty lg:text-lg">
					<div class="h-12 w-24">{#include('$components/svgs/quotes.svg')}</div>
					<br />
					<div>
						{= t.stack_tw_1 }
						<a href="https://github.com/tailwindlabs/tailwindcss/releases/tag/v{= tw }" target="_blank" rel="noopener noreferrer" aria-label="Tailwind release on Github" class="text-brand hover:underline whitespace-nowrap">
							<div class="text-brand -mr-2 inline-flex size-5 lg:size-6">{#include('$components/svgs/link.svg')}</div>
							<div class="inline-flex whitespace-nowrap">{= tw }</div>
						</a>{= t.stack_tw_2 }
					</div>
					<div class="text-md pt-8 md:text-xl lg:pt-12">
						<a href="https://tailwindcss.com/" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline inline-flex flex-row items-center gap-2 transition-all">
							<div class="text-brand size-7 lg:size-8">{#include('$components/svgs/link.svg')}</div>
							<span>https://tailwindcss.com</span>
						</a>
					</div>
				</div>
			</div>

			<div class="pt-g grid grid-cols-1 gap-12 md:grid-cols-2 lg:flex-row lg:items-center lg:gap-24">
				<div class="blurred stack-bg-3 flex h-64 items-center justify-center px-8 align-middle lg:h-96">
					<img loading="lazy" src="/assets/stack/cloudflare-logo.svg" alt="Cloudflare logo" class="h-full px-4 md:px-0 lg:w-48 xl:w-64" />
				</div>
				<div class="text-ink place-center flex-2 self-center text-base font-semibold text-pretty lg:text-lg">
					<div class="h-12 w-24">{#include('$components/svgs/quotes.svg')}</div>
					<br />
					<div>{= t.stack_cf_1 }</div>
					<div class="text-md pt-8 md:text-xl lg:pt-12">
						<a href="https://www.cloudflare.com/" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline inline-flex flex-row items-center gap-2 transition-all">
							<div class="text-brand size-7 lg:size-8">{#include('$components/svgs/link.svg')}</div>
							<span>https://www.cloudflare.com</span>
						</a>
					</div>
					<div class="mt-2 flex flex-1 flex-row flex-wrap items-center gap-x-1 text-sm font-normal wrap-break-word">
						{= t.stack_cf_2 }
						<a href="https://speed.cloudflare.com" target="_blank" rel="noopener noreferrer" class="text-brand hover:underline flex items-center transition-all">
							<div class="text-brand w-4">{#include('$components/svgs/link.svg')}</div>
							<div class="font-semibold" data-cf-edge data-cf-template="{= edge_template }">{= edge_label }</div>
						</a>
						{= t.stack_cf_3 }
					</div>
				</div>
			</div>

			<!-- Other tools we've used and love — Svelte now lives here as a peer -->
			<div class="text-ink pt-g flex flex-col gap-16 self-center text-lg font-semibold text-pretty lg:text-3xl lg:leading-9 xl:flex-row xl:items-center">
				<div class="flex-1">{= t.stack_other }</div>
				<div class="flex flex-2 flex-wrap items-center justify-center gap-8 md:gap-10 lg:gap-12">
					<a href="https://svelte.dev/" target="_blank" rel="noopener noreferrer" aria-label="Svelte web site">
						<img loading="lazy" src="/assets/stack/svelte-horizontal.svg" alt="Svelte logo" class="w-40 transition-all hover:opacity-40" />
					</a>
					<a href="https://astro.build/" target="_blank" rel="noopener noreferrer" aria-label="Astro web site">
						<img loading="lazy" src="/assets/stack/astro-logo.svg" alt="Astro logo" class="w-48 transition-all hover:opacity-40" width="460" height="160" />
					</a>
					<a href="https://laravel.com/" target="_blank" rel="noopener noreferrer" aria-label="Laravel web site">
						<div class="flex w-48 justify-center transition-all hover:opacity-40">
							<div class="flex items-center gap-x-4">
								<img loading="lazy" src="/assets/stack/laravel-logo.svg" alt="Laravel logo" width="50" height="52" />
								<img loading="lazy" src="/assets/stack/laravel-logotype.svg" alt="Laravel" width="114" height="29" />
							</div>
						</div>
					</a>
				</div>
			</div>

			<div class="pt-g flex flex-col justify-center gap-x-16 gap-y-16 xl:flex-row">
				<div class="text-muted place-center text-md max-w-4xl flex-2 self-center text-center text-sm text-pretty lg:text-xl">
					{= t.stack_disclaimer }
				</div>
			</div>
		</div>
	</div>

	<!-- ── Success ── -->
	<div class="success-bg border-t border-divider" style="content-visibility: auto; contain-intrinsic-size: auto 1000px;">
		<div class="container mx-auto w-full py-g flex flex-row md:gap-20">
			<div class="hidden flex-1 xl:block"></div>
			<div class="bg-divider mt-8 hidden h-px w-full max-w-40 md:block lg:mt-9"></div>

			<div class="flex max-w-3xl flex-col gap-y-5">
				<md-text type="text-xl" class="mb-6 font-semibold md:mb-24">{~ props.t.success_xl }</md-text>
				<md-text type="text">{~ props.t.success_1 }</md-text>
				<md-text type="text">{~ props.t.success_2 }</md-text>

				<div class="mt-6 flex flex-col gap-x-6 gap-y-8 sm:flex-row md:mt-24">
					<div class="blurred flex flex-1 flex-col justify-center p-8 md:p-12">
						<div class="text-brand text-[128px] font-semibold">{= props.years_of_experience }</div>
						<div class="text-ink text-xl">{= t.years_experience }</div>
					</div>

					<div class="flex flex-1 flex-col gap-y-8">
						<div class="blurred flex flex-col p-8 md:p-12">
							<div class="text-brand text-7xl font-semibold">70+</div>
							<div class="text-ink text-xl">{= t.completed_projects }</div>
						</div>
						<div class="blurred flex flex-col p-8 md:p-12">
							<div class="text-brand text-7xl font-semibold">40+</div>
							<div class="text-ink text-xl">{= t.clients }</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- ── Testimonials ── -->
	<div class="py-g container mx-auto" style="content-visibility: auto; contain-intrinsic-size: auto 1200px;">
		<div class="flex flex-row items-end justify-between">
			<div class="flex flex-col">
				<md-text type="h1" as="h2" class="font-semibold">{~ props.t.testimonials_h1 }</md-text>
			</div>
		</div>
		<div class="mt-24 flex flex-col gap-y-8 md:gap-y-14">
			{#each props.testimonials[lang] as item, id}
				<testimonial-card item="{= item }" class="{= id % 2 === 0 ? '' : 'self-end' }"></testimonial-card>
			{/each}
		</div>
	</div>
</main>
