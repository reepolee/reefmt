{#layout("layout") }

{#with props}
	<div class="p-4">

		<div class="flex items-center justify-between">
			<h1 class="mb-4">{= ui.title }</h1>
			<div class="text-sm">{~ js_timestamp_to_locale_string(record.updated_at ?? record.created_at)}</div>
		</div>

		{#if form_errors}
			<div class="py-4">
				<app-banner type="red">{= form_errors }</app-banner>
			</div>
		{/if}

		<form method="POST" action="{~ localized_path(action) }" class="grid gap-4 max-w-[60ch]" id="entry-form">

			<!-- CSRF token -->
			<input type="hidden" name="_csrf_token" value="{= csrf_token }" />

			<!-- crud:fields:start -->
			<field-wrapper class="grid" data-field="code">
	<label class="px-3" for="code">{= labels.code}</label>
	<input type="text" id="code" name="code" value="{= record.code}" />
	<validation-error class="mt-1" id="error-code"></validation-error>
</field-wrapper>

<field-wrapper class="grid" data-field="name">
	<label class="px-3" for="name">{= labels.name}</label>
	<input type="text" id="name" name="name" value="{= record.name}" />
	<validation-error class="mt-1" id="error-name"></validation-error>
</field-wrapper>

			<!-- crud:fields:end -->

			<!-- Store referrer URL as hidden field -->
			<input type="hidden" id="return_url" name="_return_url" value="" />

			<!-- Save action: hidden field set by onclick on save buttons -->
			<input type="hidden" name="_save_action" id="save_action" value="" />

			<div class="flex gap-2 mt-8 items-center">
				<button id="btn-submit" type="submit" onclick="document.getElementById('save_action').value='stay'">{= actions.save }</button>
				<button id="btn-save-close" type="submit" onclick="document.getElementById('save_action').value='close'" class="button secondary">{= actions.save_close }</button>
				<button id="btn-cancel" type="button" onclick="history.back()" class="button secondary">{= actions.cancel}</button>

				{#if (record.id) && enable_delete }
					<button id="action_delete" type="button" command="show-modal" commandfor="action_delete_dialog" class="ml-auto button tertiary">{= actions.delete}</button>
				{/if}
			</div>
		</form>
<!-- crud:children:start -->
<div class="child-list mt-8 bg-surface-raised rounded-lg shadow p-4 max-w-max" data-child-section="equipment_items">
	<h2 class="text-lg font-semibold mb-4">{= props.parent_label }</h2>
	{#if props.child_records && props.child_records.length > 0}
		<div class="grid gap-x-8 items-center font-semibold" style="grid-template-columns: {= props.child_columns_grid_cols }">
						<div class="child-header {= child_columns.title.class }">{= child_fields.title }</div>
			<div class="child-header {= child_columns.equipment_code.class }">{= child_fields.equipment_code }</div>
			<div class="child-header {= child_columns.cena.class }">{= child_fields.cena }</div>
			<div class="child-header {= child_columns.kratica.class }">{= child_fields.kratica }</div>
			<div class="child-header text-right">{= props.child_ui.actions }</div>
			{#each props.child_records as child}
				<div class="grid grid-cols-subgrid col-span-full items-center border-t border-slate-100 py-2 hover:bg-slate-200/50 font-normal">
									<div class="child-field {= props.child_columns.title.class }">{= child.title }</div>
				<div class="child-field {= props.child_columns.equipment_code.class }">{= child.equipment_code }</div>
				<div class="child-field {= props.child_columns.cena.class }">{~ display_currency(child.cena) }</div>
				<div class="child-field {= props.child_columns.kratica.class }">{= child.kratica }</div>

					<div class="flex items-center gap-2 px-2">
						<button type="button" class="p-1 rounded hover:bg-neutral-100 transition-transform hover:scale-105 hover:shadow" data-edit-child data-child-id="{= child.id }" title="{= child_ui.edit }">📝</button>
						<button type="button" class="bg-transparent border-0 p-1 rounded cursor-pointer hover:bg-neutral-100 transition-transform hover:scale-105 hover:shadow" data-delete-child data-child-id="{= child.id }" title="{= child_ui.delete }"><!-- bare `delete` would break — `delete` is a JS keyword -->🗑️</button>
					</div>
				</div>
			{/each}
		</div>
	{:else}
		<p class="text-slate-400 italic">{= props.child_ui.empty_text || "No equipment items found." }</p>
	{/if}
	<button type="button" class="button primary mt-4 inline-flex items-center gap-1" data-new-child>{= props.child_ui.new_button }</button>
</div>

<!-- Child CRUD dialog -->
<dialog id="child-dialog-equipment_items" class="p-0 rounded-xl shadow-2xl w-[90vw] max-w-[60ch] max-h-[90vh]">
	<div class="p-6 overflow-y-auto max-h-[80vh]">
		<div class="flex items-center justify-between mb-4">
			<h2 id="child-dialog-title-equipment_items" class="text-lg font-semibold">{= props.child_ui.new_title }</h2>
			<button type="button" class="p-1 rounded hover:bg-neutral-100 text-2xl leading-none" commandfor="child-dialog-equipment_items" command="close">&times;</button>
		</div>

		<div id="child-form-errors-equipment_items" class="hidden py-4">
			<app-banner type="red"><span id="child-form-errors-text-equipment_items"></span></app-banner>
		</div>

		<form id="child-form-equipment_items" class="grid gap-4">
			{#with props}
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<input type="hidden" name="equipment_code" id="child-parent-fk-equipment_items" value="" />

				<!-- crud:child:fields:start -->
				<field-wrapper class="grid" data-field="title">
	<label class="px-3" for="title">{= child_fields.title }</label>
	<input type="text" id="title" name="title" value="" />
	<validation-error class="mt-1" id="error-title"></validation-error>
</field-wrapper>

<field-wrapper class="grid" data-field="cena">
	<label class="px-3" for="cena">{= child_fields.cena }</label>
	<input type="number" id="cena" name="cena" value="" />
	<validation-error class="mt-1" id="error-cena"></validation-error>
</field-wrapper>

<field-wrapper class="grid" data-field="kratica">
	<label class="px-3" for="kratica">{= child_fields.kratica }</label>
	<input type="text" id="kratica" name="kratica" value="" />
	<validation-error class="mt-1" id="error-kratica"></validation-error>
</field-wrapper>
				<!-- crud:child:fields:end -->

				<div class="flex gap-2 mt-6 items-center">
					<button id="child-btn-submit-equipment_items" type="submit" class="button primary">{= actions.save}</button>
					<button type="button" class="button secondary" commandfor="child-dialog-equipment_items" command="close">{= actions.cancel}</button>
				</div>
			{/with}
		</form>
	</div>
</dialog>

<!-- Child delete confirmation dialog -->
<dialog id="child-delete-dialog-equipment_items" class="p-0 rounded-xl shadow-2xl w-100">
	<div class="p-6">
		<h2 class="text-lg font-semibold">{= props.actions.delete}</h2>
		<div class="mt-6 flex justify-end gap-2">
			<button class="px-3 py-1 rounded bg-slate-200" type="button" commandfor="child-delete-dialog-equipment_items" command="close">{= props.actions.cancel}</button>
			<button id="child-btn-confirm-delete-equipment_items" class="px-3 py-1 rounded bg-brand text-white" type="button" data-dialog-confirm>{= props.actions.confirm_delete}</button>
		</div>
	</div>
</dialog>

<script>
	(() => {
		const container = document.querySelector('[data-child-section="equipment_items"]');
		if (!container) return;
		const dialog = document.getElementById("child-dialog-equipment_items");
		const form = document.getElementById("child-form-equipment_items");
		const title = document.getElementById("child-dialog-title-equipment_items");
		const errors = document.getElementById("child-form-errors-equipment_items");
		const errors_text = document.getElementById(
		"child-form-errors-text-equipment_items",
		);
		const parent_fk = document.getElementById("child-parent-fk-equipment_items");
		const submit_btn = document.getElementById(
		"child-btn-submit-equipment_items",
		);
		// Base path for child CRUD URLs — computed server-side via template scope
		const child_base_path = "{~ localized_path('/equipment/' + props.record.code + '/equipment_items') }";
		const parent_val = "{= props.record.code }";
	
		function qs(sel) {
			return form.querySelector(sel);
		}
	
		function fill_form(record) {
			qs('[name="title"]').value = record.title || "";
			qs('[name="cena"]').value = record.cena || "";
			qs('[name="kratica"]').value = record.kratica || "";
		}
	
		function clear_form() {
			qs('[name="title"]').value = "";
			qs('[name="cena"]').value = "";
			qs('[name="kratica"]').value = "";
		}
	
		function hide_error() {
			errors.classList.add("hidden");
		}
	
		function show_error(msg) {
			errors_text.textContent = msg;
			errors.classList.remove("hidden");
		}
	
		function clear_field_errors() {
			const error_fields = ["title", "cena", "kratica"];
			error_fields.forEach((name) => {
				const el = document.getElementById(`error-${name}`);
				if (el) el.innerHTML = "";
			});
		}
	
		function set_field_errors(errors) {
			for (const [name, msg] of Object.entries(errors)) {
				const el = document.getElementById(`error-${name}`);
				if (el) el.innerHTML = msg;
			}
		}
	
		// Edit buttons — scoped to this child's container
		container.querySelectorAll("[data-edit-child]").forEach((btn) => {
			btn.addEventListener("click", async function() {
				const child_id = this.dataset.childId;
				hide_error();
				clear_field_errors();
	
				try {
					const csrf_token = document.cookie.match(/csrf_token=([^;]+)/)?.[1] || "";
					const res = await fetch(
					`${child_base_path}/${child_id}/edit-data`,
					);
					const data = await res.json();
					if (data.error) {
						show_error(data.error);
						return;
					}
					fill_form(data.record);
					parent_fk.value = parent_val;
					form.action = `${child_base_path}/${child_id}/edit`;
					title.textContent = "{= props.child_ui.edit_title }";
					submit_btn.textContent = "{= props.actions.save}";
					dialog.showModal();
				} catch (e) {
					show_error("{= props.child_ui.error_loading }");
				}
			});
		});
	
		// New button — scoped to this child's container
		const new_btn = container.querySelector("[data-new-child]");
		if (new_btn) {
			new_btn.addEventListener("click", () => {
				hide_error();
				clear_field_errors();
				clear_form();
				parent_fk.value = parent_val;
				form.action = child_base_path;
				title.textContent = "{= props.child_ui.new_title }";
				submit_btn.textContent = "{= props.actions.save}";
				dialog.showModal();
			});
		}
	
		// Form submit
		form.addEventListener("submit", async (e) => {
			e.preventDefault();
			hide_error();
			submit_btn.disabled = true;
			submit_btn.textContent = "{= props.actions.submitted}";
	
			try {
				const form_data = new FormData(form);
				const res = await fetch(form.action, {
					method: "POST",
					body: new URLSearchParams(form_data),
				});
				const data = await res.json();
	
				if (data.success) {
					dialog.close();
					window.location.reload();
				} else {
					if (data.errors) {
						set_field_errors(data.errors);
					}
					show_error(
					data.form_errors
					|| "{= props.child_ui.error_saving }",
					);
					submit_btn.disabled = false;
					submit_btn.textContent = "{= props.actions.save}";
				}
			} catch (e) {
				show_error("{= props.child_ui.error_saving }");
				submit_btn.disabled = false;
				submit_btn.textContent = "{= props.actions.save}";
			}
		}); // Blur validation
		form.addEventListener("focusout", async (e) => {
			const el = e.target;
			if (!el?.name || el.tagName === "BUTTON") return;
	
			try {
				const fd = new FormData(form);
				const values = Object.fromEntries(fd.entries());
				values.touched = [el.name];
	
				const res = await fetch(`${child_base_path}/validate`, {
					method: "POST",
					headers: { "Content-Type": "application/json" },
					body: JSON.stringify(values),
				});
				const data = await res.json();
				if (data.errors) {
					const error_el = document.getElementById(`error-${el.name}`);
					if (error_el) error_el.innerHTML = data.errors[el.name] || "";
				} else {
					// Clear this field's error if validation passed
					const error_el = document.getElementById(`error-${el.name}`);
					if (error_el) error_el.innerHTML = "";
				}
			} catch (e) {
				// Silent fail for blur validation
			}
		});
	
		// Child delete confirmation dialog
		const delete_dialog = document.getElementById(
		"child-delete-dialog-equipment_items",
		);
		const delete_confirm_btn = document.getElementById(
		"child-btn-confirm-delete-equipment_items",
		);
		let pending_delete_id = "";
	
		if (delete_dialog) {
			delete_dialog.addEventListener("confirm", async () => {
				const original_text = delete_confirm_btn.textContent;
				delete_confirm_btn.disabled = true;
				delete_confirm_btn.textContent = "{= props.child_ui.deleting }";
	
				try {
					const res = await fetch(
					`${child_base_path}/${pending_delete_id}/edit`,
					{
						method: "POST",
						headers: {
							"Content-Type": "application/x-www-form-urlencoded",
							"X-CSRF-Token": csrf_token,
						},
						body: new URLSearchParams({
							_action: "delete",
							_csrf_token: csrf_token,
						}),
					},
					);
					const data = await res.json();
					if (data.success) {
						window.location.reload();
					} else {
						delete_confirm_btn.disabled = false;
						delete_confirm_btn.textContent = original_text;
						show_error(
						data.error || "{= props.child_ui.error_deleting }",
						);
					}
				} catch (e) {
					delete_confirm_btn.disabled = false;
					delete_confirm_btn.textContent = original_text;
					show_error("{= props.child_ui.error_deleting }");
				}
			});
		} // Show confirmation dialog instead of native confirm() — scoped to this child's container
		container.querySelectorAll("[data-delete-child]").forEach((btn) => {
			btn.addEventListener("click", function() {
				pending_delete_id = this.dataset.childId;
				delete_dialog.showModal();
			});
		});
	})();
</script>
<!-- crud:children:end -->

		{#if (record.id) && enable_delete }
			<form id="delete-form" method="POST" action="{~ localized_path('/user/equipment/' + record.code + '/edit') }" style="display: none;">
				<input type="hidden" name="_csrf_token" value="{= csrf_token }" />
				<input type="hidden" name="_action" value="delete" />
			</form>
		{/if}

	</div>

	{#if enable_delete }
		<dialog id="action_delete_dialog" class="p-0 rounded-xl shadow-2xl w-100">
			<div class="p-6">
				<h2 class="text-lg font-semibold">{= actions.delete}</h2>
				<div class="mt-6 flex justify-end gap-2">
					<button class="px-3 py-1 rounded bg-slate-200" type="button" commandfor="action_delete_dialog" command="close">{= actions.abort_delete}</button>
					<button class="px-3 py-1 rounded bg-brand text-white" type="button" data-dialog-confirm>{= actions.confirm_delete}</button>
				</div>
			</div>
		</dialog>
	{/if}
	<script src="/dialog-confirm.js?v={= version}"></script>
	<script src="/form-controller.js?v={= version}" defer></script>

	<script>
		const return_url_field = $("#return_url");
		if (return_url_field && document.referrer) {
			try {
				const referer_url = new URL(document.referrer);
				return_url_field.value = referer_url.pathname + referer_url.search;
			} catch (e) {}
		}
	</script>
	
	{#if enable_delete }
		<script>
			$("#action_delete_dialog").addEventListener("confirm", () => {
				$("#delete-form").submit();
			});
		</script>
	{/if}
	
	<script>
		document.addEventListener("DOMContentLoaded", () => {
			new FormController({
				form: "#entry-form",
				validate_url: "{~ localized_path('/user/equipment/validate') }",
				submitted_text: "{~ actions.submitted }",
			});
		});
	</script>
{/with}
